---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";
---

<Layout
  title="About Catalyst"
  description="Catalyst is an open-source game server panel in early testing: TypeScript panel with Rust node agent and containerd. Meet the project and its principles."
  canonicalUrl="https://catalystctl.com/about/"
  breadcrumbItems={[{ name: "About" }]}
>
  <div class="max-w-6xl mx-auto px-4 pt-10 sm:pt-14 pb-16">
    <!-- Hero -->
    <div class="max-w-3xl" data-speakable>
      <div class="flex items-center gap-2">
        <span class="led-wrap"><span class="led-pulse bg-success"></span><span class="led bg-success"></span></span>
        <span class="type-overline">Open source · GPLv3 · early testing</span>
      </div>
      <h1 class="mt-4 font-display text-[1.9rem] sm:text-[2.5rem] font-semibold text-foreground tracking-tight leading-[1.12] text-balance">
        About the Catalyst project.
      </h1>
      <p class="mt-4 text-data sm:text-base text-muted-foreground leading-relaxed text-pretty">
        Catalyst is an open-source game server panel in early testing: a TypeScript panel with a Rust node agent running on containerd. It includes a live console, 258 egg definitions across 167 games, a plugin system, and a one-command panel install. Panel GPLv3, agent MIT/Apache-2.0.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-md btn-primary">View on GitHub</a>
        <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="btn btn-md btn-outline">Join Discord</a>
      </div>
    </div>

    <div class="rule mt-12"></div>

    <!-- Principles -->
    <section class="py-10" aria-label="Principles">
      <h2 class="font-display text-lg font-semibold text-foreground mb-5">Principles</h2>
      <div class="deck-panel overflow-hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border/40">
        <div class="bg-card p-4">
          <h3 class="font-display text-data font-semibold text-foreground tracking-tight">Open source, no paid tiers</h3>
          <p class="mt-1.5 text-mini text-muted-foreground leading-relaxed">Panel GPLv3, agent MIT/Apache-2.0. Code on GitHub. No feature gates. Early testing; expect rough edges.</p>
        </div>
        <div class="bg-card p-4">
          <h3 class="font-display text-data font-semibold text-foreground tracking-tight">Documented architecture</h3>
          <p class="mt-1.5 text-mini text-muted-foreground leading-relaxed">TypeScript Fastify panel (PostgreSQL + Redis) with a containerd-native Rust agent. Live console, files, SFTP, backups, and scheduling.</p>
        </div>
        <div class="bg-card p-4">
          <h3 class="font-display text-data font-semibold text-foreground tracking-tight">Extensible without forking</h3>
          <p class="mt-1.5 text-mini text-muted-foreground leading-relaxed">Plugin system with hooks, routes, and scheduled tasks, so you never maintain a fork.</p>
        </div>
      </div>
    </section>

    <div class="rule"></div>

    <!-- Team -->
    <section class="py-10" aria-label="Team">
      <h2 class="font-display text-lg font-semibold text-foreground mb-3">Team</h2>
      <p class="text-mini text-muted-foreground leading-relaxed max-w-2xl mb-5">
        Catalyst is built by contributors who run game servers themselves: hosting providers, systems engineers, and players who got tired of PHP and Docker overhead. The project is community-maintained and welcomes contributors.
      </p>
      <div class="deck-panel px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-mini text-chalk/70">Want to contribute? The guide is on GitHub.</p>
        <a href={GITHUB_URL + "/blob/main/CONTRIBUTING.md"} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline shrink-0">
          Contributing guide
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
        </a>
      </div>
    </section>

    <div class="rule"></div>

    <!-- Project facts -->
    <section class="py-10" aria-label="Project facts">
      <h2 class="font-display text-lg font-semibold text-foreground mb-5">Project facts</h2>
      <div class="deck-panel overflow-hidden grid grid-cols-2 sm:grid-cols-4 gap-px bg-border/40">
        {[
          { value: "GPLv3", label: "License" },
          { value: "TS + Rust", label: "Panel + agent" },
          { value: "containerd", label: "Nodes runtime" },
          { value: "200+", label: "API route handlers" },
        ].map((fact) => (
          <div class="bg-card p-4">
            <div class="type-overline">{fact.label}</div>
            <div class="mt-1.5 font-mono text-lg font-semibold text-foreground tabular-nums">{fact.value}</div>
          </div>
        ))}
      </div>
    </section>

    <div class="rule"></div>

    <!-- Links -->
    <section class="py-10" aria-label="Links">
      <div class="deck-panel overflow-hidden grid grid-cols-1 sm:grid-cols-3 gap-px bg-border/40">
        <a href={B + "pterodactyl-alternative/"} class="group bg-card p-4 transition-colors hover:bg-surface-1/40">
          <span class="type-overline">Compare</span>
          <h3 class="mt-1.5 font-display text-data font-semibold text-foreground group-hover:text-primary transition-colors">Catalyst vs Pterodactyl</h3>
          <p class="mt-1 text-micro text-muted-foreground">Architecture, performance, and features side by side.</p>
        </a>
        <a href="https://docs.catalystctl.com/" class="group bg-card p-4 transition-colors hover:bg-surface-1/40">
          <span class="type-overline">Docs</span>
          <h3 class="mt-1.5 font-display text-data font-semibold text-foreground group-hover:text-primary transition-colors">Documentation</h3>
          <p class="mt-1 text-micro text-muted-foreground">Install, configure, and extend the panel.</p>
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="group bg-card p-4 transition-colors hover:bg-surface-1/40">
          <span class="type-overline">Source</span>
          <h3 class="mt-1.5 font-display text-data font-semibold text-foreground group-hover:text-primary transition-colors">GitHub</h3>
          <p class="mt-1 text-micro text-muted-foreground">Source, issues, and releases.</p>
        </a>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Catalyst",
    "url": "https://catalystctl.com/about/",
    "description": "Catalyst is an open-source game server panel in early testing: TypeScript panel with Rust node agent and containerd.",
    "mainEntity": {
      "@type": "Organization",
      "@id": "https://catalystctl.com/#organization",
      "name": "Catalyst",
      "url": "https://catalystctl.com/",
      "logo": "https://catalystctl.com/logo-512.png",
      "sameAs": [GITHUB_URL, DISCORD_URL],
    },
  })} />
</Layout>
