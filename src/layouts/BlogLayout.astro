---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";

const AUDIENCE_LABELS: Record<string, string> = {
  hobbyists: "Hobbyists",
  businesses: "Businesses",
  "hosting-providers": "Hosting Providers",
  enterprises: "Enterprises",
};

const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedFormattedDate = entry.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  schemaType="BlogPosting"
  publishDate={entry.data.pubDate.toISOString()}
  modifiedDate={entry.data.updatedDate?.toISOString()}
  ogImage={entry.data.ogImage}
  canonicalUrl={`https://catalystctl.com/blog/${entry.id}/`}
  keywords={entry.data.keywords}
  breadcrumbItems={[{ name: "Blog", href: "blog/" }, { name: entry.data.title }]}
>
  <article class="relative">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-64 bg-[radial-gradient(ellipse_at_top,hsl(29_47%_56%/0.07),transparent_60%)]" aria-hidden="true"></div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-8 pt-10 sm:pt-14 pb-16 sm:pb-20">
      <nav class="text-xs text-zinc-600 mb-8" aria-label="Breadcrumb">
        <a href={B} class="hover:text-zinc-400 transition-colors">Home</a>
        <span class="mx-1.5 text-zinc-700">/</span>
        <a href={B + "blog/"} class="hover:text-zinc-400 transition-colors">Blog</a>
        <span class="mx-1.5 text-zinc-700">/</span>
        <span class="text-zinc-400 line-clamp-1">{entry.data.title}</span>
      </nav>

      <header class="mb-12">
        {entry.data.audience && entry.data.audience.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mb-5">
            {entry.data.audience.map((a) => (
              <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-[11px] font-medium text-primary">
                {AUDIENCE_LABELS[a] || a}
              </span>
            ))}
          </div>
        )}

        <h1 class="font-display text-3xl sm:text-4xl lg:text-[2.75rem] font-bold text-foreground leading-[1.12] tracking-tight text-balance">
          {entry.data.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed max-w-2xl text-pretty">
          {entry.data.description}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-500">
          <div class="flex items-center gap-2">
            <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/15 text-primary">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
            </div>
            <span class="text-zinc-300">{entry.data.author}</span>
          </div>
          <span class="hidden sm:inline w-px h-4 bg-zinc-800" aria-hidden="true"></span>
          <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
          {updatedFormattedDate && (
            <>
              <span class="hidden sm:inline w-px h-4 bg-zinc-800" aria-hidden="true"></span>
              <span class="text-zinc-600">Updated {updatedFormattedDate}</span>
            </>
          )}
        </div>
      </header>

      <div class="h-px bg-gradient-to-r from-transparent via-zinc-800 to-transparent mb-10" aria-hidden="true"></div>

      <div class="doc">
        <slot />
      </div>

      <div class="mt-16 relative rounded-2xl border border-primary/20 overflow-hidden p-6 sm:p-8">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute inset-x-0 top-0 h-48 hero-glow"></div>
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary/[0.12] rounded-full blur-3xl"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-primary/[0.05] rounded-full blur-3xl"></div>
        </div>
        <div class="relative">
          <h2 class="font-display text-lg sm:text-xl font-semibold text-foreground">Spin up a panel tonight.</h2>
          <p class="mt-2 text-sm text-zinc-400 max-w-md">Free, GPLv3, no feature gates. One command and you are live.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={B + "#install"} class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-all hover:bg-primary-600 active:scale-[0.98] shadow-[0_0_0_1px_hsl(29_47%_50%/0.3),0_8px_28px_-8px_hsl(29_47%_56%/0.45)]">
              Install in 60s
            </a>
            <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-4 py-2.5 text-sm font-medium text-zinc-300 transition-all hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98]">
              Join Discord
            </a>
            <a href={B + "pterodactyl-alternative/"} class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-4 py-2.5 text-sm font-medium text-zinc-300 transition-all hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98]">
              Open comparison
            </a>
          </div>
        </div>
      </div>

      <nav class="mt-10 pt-8 border-t border-zinc-800/60 flex flex-wrap items-center justify-between gap-4">
        <a href={B + "blog/"} class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-400 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
          All posts
        </a>
        <div class="flex flex-wrap items-center gap-4">
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-600 hover:text-zinc-400 transition-colors">
            Discord
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-600 hover:text-zinc-400 transition-colors">
            Source on GitHub
          </a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
