---
---
<div
  id="consent-banner"
  class="fixed inset-x-4 bottom-4 z-[70] hidden"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
>
  <div class="max-w-2xl max-h-[calc(100dvh-2rem)] overflow-y-auto mx-auto rounded-lg border border-border/70 bg-surface-1/95 backdrop-blur-xl shadow-elevated p-5 sm:p-6">
    <h2 class="deck-label">We use cookies</h2>
    <p class="mt-2 text-mini text-chalk/70 leading-relaxed">
      We use cookies to measure traffic and improve the docs. Choose Accept to allow
      analytics and marketing cookies, or Reject to continue with necessary-only cookies.
    </p>
    <div id="consent-prefs" class="mt-4 hidden space-y-2.5 border-t border-border/60 pt-4">
      <label class="flex items-center justify-between gap-4 text-mini">
        <span class="text-chalk/85">Necessary <span class="text-muted-foreground/70">(always on)</span></span>
        <input type="checkbox" checked disabled class="h-4 w-4 accent-muted-foreground" aria-label="Necessary cookies, always on" />
      </label>
      <label class="flex items-center justify-between gap-4 text-mini">
        <span class="text-chalk/85">Analytics</span>
        <input id="consent-toggle-analytics" type="checkbox" class="h-4 w-4 accent-primary" />
      </label>
      <label class="flex items-center justify-between gap-4 text-mini">
        <span class="text-chalk/85">Advertising</span>
        <input id="consent-toggle-ads" type="checkbox" class="h-4 w-4 accent-primary" />
      </label>
      <label class="flex items-center justify-between gap-4 text-mini">
        <span class="text-chalk/85">Functional</span>
        <input id="consent-toggle-functional" type="checkbox" class="h-4 w-4 accent-primary" />
      </label>
    </div>
    <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-2">
      <button
        id="consent-accept"
        type="button"
        class="pressable inline-flex items-center justify-center rounded-sm bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-600"
      >
        Accept all
      </button>
      <button
        id="consent-reject"
        type="button"
        class="pressable inline-flex items-center justify-center rounded-sm border border-border/70 px-4 py-2.5 text-sm font-medium text-chalk/85 transition-colors hover:bg-surface-2 hover:text-foreground"
      >
        Reject
      </button>
      <button
        id="consent-customize"
        type="button"
        class="inline-flex items-center justify-center rounded-sm px-4 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground/90"
        aria-expanded="false" aria-controls="consent-prefs"
      >
        Customize
      </button>
      <button
        id="consent-save"
        type="button"
        class="hidden inline-flex items-center justify-center rounded-sm border border-border/70 px-4 py-2.5 text-sm font-medium text-foreground/90 transition-colors hover:bg-surface-2"
      >
        Save choices
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var KEY = "catalyst-consent-v1";
  var banner = document.getElementById("consent-banner");
  var prefs = document.getElementById("consent-prefs");
  var customizeBtn = document.getElementById("consent-customize");
  var saveBtn = document.getElementById("consent-save");
  if (!banner) return;

  function read() {
    try {
      var raw = localStorage.getItem(KEY);
      if (!raw) return null;
      var state = JSON.parse(raw);
      return state && typeof state.analytics === "boolean" && typeof state.ads === "boolean" && typeof state.functional === "boolean" ? state : null;
    } catch {
      return null;
    }
  }

  function write(state) {
    try {
      localStorage.setItem(KEY, JSON.stringify(state));
    } catch {
      /* storage unavailable; banner simply reappears next visit */
    }
    try {
      document.cookie =
        "catalyst-consent=" +
        encodeURIComponent(state.analytics ? "granted" : "denied") +
        "; Max-Age=15552000; Path=/; SameSite=Lax; Secure";
    } catch {
      /* cookies blocked; consent still enforced via defaults */
    }
  }

  function pushConsent(state, recordChoice) {
    window.dataLayer = window.dataLayer || [];
    var granted = function (v) {
      return v ? "granted" : "denied";
    };
    var update = {
      ad_storage: granted(state.ads),
      ad_user_data: granted(state.ads),
      ad_personalization: granted(state.ads),
      analytics_storage: granted(state.analytics),
      functionality_storage: granted(state.functional),
      personalization_storage: granted(state.functional),
      security_storage: "granted",
    };
    if (typeof window.gtag === "function") {
      window.gtag("consent", "update", update);
    } else {
      window.dataLayer.push({ event: "consent_update", consent: update });
    }
    if (state.analytics || state.ads) window.catalystLoadAnalytics?.();
    if (!recordChoice) return;
    window.dataLayer.push({
      event: "consent_choice",
      consent_analytics: state.analytics,
      consent_ads: state.ads,
      consent_functional: state.functional,
    });
  }

  var returnFocus = null;
  function hide() {
    banner.classList.add("hidden");
    prefs?.classList.add("hidden");
    saveBtn?.classList.add("hidden");
    customizeBtn?.setAttribute("aria-expanded", "false");
    if (customizeBtn) customizeBtn.textContent = "Customize";
    if (returnFocus && returnFocus.isConnected) returnFocus.focus();
    returnFocus = null;
  }

  function show() {
    returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    var stored = read();
    for (var [id, value] of [["consent-toggle-analytics", stored?.analytics], ["consent-toggle-ads", stored?.ads], ["consent-toggle-functional", stored?.functional]]) {
      var toggle = document.getElementById(id);
      if (toggle instanceof HTMLInputElement) toggle.checked = value ?? false;
    }
    banner.classList.remove("hidden");
    document.getElementById("consent-accept")?.focus();
  }

  function choose(state) {
    var full = {
      necessary: true,
      analytics: !!state.analytics,
      ads: !!state.ads,
      functional: !!state.functional,
      ts: new Date().toISOString(),
    };
    write(full);
    pushConsent(full, true);
    hide();
  }

  document.getElementById("consent-accept")?.addEventListener("click", function () {
    choose({ analytics: true, ads: true, functional: true });
  });
  document.getElementById("consent-reject")?.addEventListener("click", function () {
    choose({ analytics: false, ads: false, functional: false });
  });
  customizeBtn?.addEventListener("click", function () {
    var open = prefs?.classList.toggle("hidden") === false;
    customizeBtn.setAttribute("aria-expanded", open ? "true" : "false");
    customizeBtn.textContent = open ? "Hide options" : "Customize";
    saveBtn?.classList.toggle("hidden", !open);
  });
  saveBtn?.addEventListener("click", function () {
    choose({
      analytics: document.getElementById("consent-toggle-analytics")?.checked ?? false,
      ads: document.getElementById("consent-toggle-ads")?.checked ?? false,
      functional: document.getElementById("consent-toggle-functional")?.checked ?? false,
    });
  });

  window.catalystShowCookieSettings = function () {
    show();
  };

  var stored = read();
  if (stored) {
    pushConsent(stored);
  } else {
    window.setTimeout(show, 600);
  }
  banner.addEventListener("keydown", function (event) {
    if (event.key !== "Tab") return;
    var items = Array.from(banner.querySelectorAll('button:not(.hidden), input:not([disabled])'))
      .filter(function (el) { return !el.closest('.hidden'); });
    var first = items[0], last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
  });
})();
</script>
