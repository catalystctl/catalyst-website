---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";

const autoSteps = [
  {
    number: "1",
    title: "Deploy Catalyst",
    description: "Install on the target host with the one-line script. Compose, secrets, and panel bootstrap land automatically.",
    details: [
      "curl -fsSL https://raw.githubusercontent.com/catalystctl/catalyst/main/install.sh | bash",
      "Edit the generated .env and set PUBLIC_URL",
      "docker compose up -d for panel, API, and database",
      "Provision a Catalyst node and confirm it is online",
    ],
  },
  {
    number: "2",
    title: "Connect Pterodactyl",
    description: "Create API keys on the old panel and verify reachability from Catalyst Admin → Migration.",
    details: [
      "Create an Application API key (ptla_*) with full read access",
      "Create a Client API key (ptlc_*) for files and backups",
      "Enter the Pterodactyl URL and keys in Catalyst",
      "Run Test Connection before you import anything",
    ],
  },
  {
    number: "3",
    title: "Map nodes and migrate",
    description: "Pick full, node, or server scope. Map nodes, start the job, and watch per-server progress.",
    details: [
      "Choose scope: full, node, or individual servers",
      "Map each Pterodactyl node to a Catalyst node",
      "Start Migration to import users, eggs, allocations, and servers",
      "Monitor steps, status, and retries in real time",
    ],
  },
  {
    number: "4",
    title: "Verify and cut over",
    description: "Boot a few servers, check files, flip DNS, then wind down Pterodactyl.",
    details: [
      "Start a migrated server and watch the Catalyst console",
      "Confirm ownership, permissions, and configs",
      "Point DNS A records at the Catalyst panel",
      "Stop Pterodactyl and watch Catalyst logs for 24-48 hours",
    ],
  },
];

const migratedItems = [
  {
    title: "Nodes and allocations",
    description: "Pterodactyl nodes map to Catalyst nodes. IP allocations and port ranges recreate automatically.",
  },
  {
    title: "Users and roles",
    description: "Accounts, emails, and passwords import. Admin/user roles map into Catalyst RBAC with 50+ permissions for you to refine.",
  },
  {
    title: "Eggs and templates",
    description: "Eggs become Catalyst templates. Variables, images, install scripts, and startup commands transfer. Review Docker-specific bits for containerd.",
  },
  {
    title: "Servers and files",
    description: "Specs, env vars, and ports recreate. File data streams from Pterodactyl volumes into Catalyst node storage.",
  },
];

const faqs = [
  {
    q: "Will my Pterodactyl eggs work in Catalyst?",
    a: "Usually. The migration tool converts eggs to Catalyst templates. Startup commands, env vars, and install scripts transfer, but review Docker-specific bits because game nodes run containerd.",
  },
  {
    q: "Can I run Catalyst and Pterodactyl side by side?",
    a: "Yes during cutover. Use a separate host or different ports with non-overlapping allocations so you can validate before DNS flips.",
  },
  {
    q: "What happens to my existing server files?",
    a: "Files stream from Pterodactyl Docker volumes into Catalyst storage. Layout stays intact and the built-in file manager helps you verify.",
  },
  {
    q: "How long does migration take?",
    a: "Config (users, eggs, nodes, allocations, metadata) finishes in minutes. File transfer scales with data size and network. Under 50 servers often lands in under an hour.",
  },
  {
    q: "Is there an automatic migration tool?",
    a: "Yes. Admin → Migration imports nodes, allocations, users, eggs, servers, and files. You can pause, resume, and retry steps.",
  },
  {
    q: "Can I migrate only some servers?",
    a: "Yes. Scopes are full, node, or server. Run multiple jobs or retry failed steps without starting over.",
  },
];

const compatibility = [
  {
    title: "Eggs and startup commands",
    body: "Templates mirror eggs conceptually. The tool converts them automatically. Review Docker-specific config because game nodes use containerd directly.",
  },
  {
    title: "Server files and volumes",
    body: "Pterodactyl keeps files under /var/lib/pterodactyl/volumes. Catalyst streams them into node storage and preserves layout.",
  },
  {
    title: "Users and permissions",
    body: "Admin/user roles map cleanly, then you can tighten them with Catalyst's 50+ permissions after import.",
  },
  {
    title: "API integrations",
    body: "The REST surface differs from Pterodactyl. Update bots and billing scripts to the Catalyst API (200+ route handlers).",
  },
];
---

<Layout
  title="Migrate from Pterodactyl to Catalyst"
  description="Migrate from Pterodactyl to Catalyst automatically. Import nodes, users, eggs, servers, and files with Catalyst's built-in migration tool."
  canonicalUrl="https://catalystctl.com/migrate-from-pterodactyl/"
  breadcrumbItems={[{ name: "Pterodactyl Alternative", href: "pterodactyl-alternative/" }, { name: "Migrate" }]}
>
  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));
  </script>

  <!-- Hero -->
  <section aria-label="Migration overview">
    <div class="max-w-6xl mx-auto px-4 pt-10 sm:pt-14 pb-8">
      <nav class="mb-6 flex items-center gap-1.5 font-mono text-micro text-muted-foreground/70" aria-label="Breadcrumb">
        <a href={B} class="hover:text-foreground transition-colors">Home</a>
        <span class="text-muted-foreground/40">/</span>
        <a href={B + "pterodactyl-alternative/"} class="hover:text-foreground transition-colors">Compare</a>
        <span class="text-muted-foreground/40">/</span>
        <span>Migrate</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-reveal>
        <div class="lg:col-span-7">
          <div class="flex items-center gap-2">
            <span class="led-wrap"><span class="led-pulse bg-success"></span><span class="led bg-success"></span></span>
            <span class="type-overline">Admin import job</span>
          </div>
          <h1 class="mt-4 font-display text-[1.9rem] sm:text-[2.4rem] font-semibold text-foreground tracking-tight leading-[1.12] text-balance">
            Migrate from <span class="text-muted-foreground">Pterodactyl</span> to Catalyst.
          </h1>
          <p class="mt-4 max-w-xl text-data sm:text-base text-muted-foreground leading-relaxed text-pretty">
            Built-in auto-migration imports nodes, users, eggs, servers, and files from the admin panel, without custom scripts.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href={B + "#install"} class="btn btn-md btn-primary">Install panel</a>
            <a href={B + "pterodactyl-alternative/#comparison"} class="btn btn-md btn-outline">Open comparison</a>
          </div>
        </div>

        <div class="lg:col-span-5 w-full">
          <div class="deck-panel overflow-hidden">
            <div class="deck-toolbar justify-between">
              <span class="deck-label">Expected timings</span>
            </div>
            {[
              { label: "Typical under 50 servers", value: "<1 hour" },
              { label: "Fresh panel install", value: "60s" },
              { label: "Import path", value: "Auto" },
            ].map((row) => (
              <div class="deck-row grid-cols-[minmax(0,1fr)_auto]">
                <span class="type-overline">{row.label}</span>
                <span class="font-mono text-data font-semibold text-foreground tabular-nums">{row.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Auto migration -->
  <section class="max-w-6xl mx-auto px-4 py-10" aria-label="Built-in auto migration">
    <div class="panel-frame overflow-hidden" data-reveal>
      <div class="deck-toolbar justify-between">
        <span class="deck-label">Built-in auto migration</span>
        <span class="deck-keyhint"><span class="led bg-success"></span> admin → migration</span>
      </div>
      <div class="p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-5">
        <div class="lg:col-span-7">
          <p class="text-mini sm:text-data text-muted-foreground leading-relaxed max-w-xl">
            Connect the Pterodactyl API, choose what to import, and Catalyst handles nodes, allocations, users, eggs, servers, and file data. Pause, resume, or retry any step.
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-wrap content-start gap-1.5">
          {["Nodes and allocations", "Users and roles", "Eggs and templates", "Servers and files"].map((t) => (
            <span class="inline-flex items-center rounded-sm border border-primary/25 bg-primary/10 px-2 py-0.5 font-mono text-micro text-primary">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Migration steps">
    <div class="mb-6 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Four steps to migrate.
      </h2>
    </div>

    <div class="deck-panel overflow-hidden" data-reveal>
      {autoSteps.map((step) => (
        <div class="border-b border-border/40 last:border-b-0">
          <div class="flex items-center gap-3 px-3 py-2 border-b border-border/40 bg-surface-1/40">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-sm border border-primary/30 font-mono text-micro font-semibold text-primary tabular-nums">{step.number}</span>
            <h3 class="font-display text-data font-semibold text-foreground tracking-tight">{step.title}</h3>
          </div>
          <div class="px-3 py-3">
            <p class="text-mini text-muted-foreground leading-relaxed">{step.description}</p>
            <ul class="mt-3 space-y-1.5">
              {step.details.map((d) => (
                <li class="flex items-start gap-2 text-micro">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-primary/70" aria-hidden="true"></span>
                  <span class="font-mono text-muted-foreground leading-relaxed">{d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- What migrates -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="What gets migrated">
    <div class="mb-6 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        What the migration imports.
      </h2>
    </div>
    <div class="deck-panel overflow-hidden grid grid-cols-1 sm:grid-cols-2 gap-px bg-border/40" data-reveal-stagger>
      {migratedItems.map((item) => (
        <div class="bg-card p-4">
          <h3 class="font-display text-data font-semibold text-foreground tracking-tight">{item.title}</h3>
          <p class="mt-1.5 text-micro text-muted-foreground leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Compatibility -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Compatibility notes">
    <div class="max-w-3xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight mb-6 text-balance">
        Compatibility notes
      </h2>
      <div>
        {compatibility.map((item) => (
          <div class="border-b border-border/50 py-5 first:pt-0 last:border-0">
            <h3 class="font-display text-data font-semibold text-foreground mb-1.5">{item.title}</h3>
            <p class="text-mini sm:text-data text-muted-foreground leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Migration FAQ">
    <div class="mb-6 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Migration questions.
      </h2>
    </div>

    <div class="deck-panel overflow-hidden grid grid-cols-1 lg:grid-cols-2 gap-px bg-border/40" data-reveal>
      {faqs.map((faq) => (
        <details class="faq-item group bg-card">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3">
            <h3 class="text-data font-medium text-foreground leading-snug pr-2">{faq.q}</h3>
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm border border-border/70 text-muted-foreground transition-colors group-open:border-primary/40 group-open:text-primary group-open:bg-primary/10">
              <svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </span>
          </summary>
          <p class="px-4 pb-4 text-mini text-muted-foreground leading-relaxed max-w-prose">{faq.a}</p>
        </details>
      ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Migrate from Pterodactyl to Catalyst",
      "description": "Migrate your Pterodactyl nodes, users, eggs, servers, and files to Catalyst using the built-in auto-migration tool.",
      "totalTime": "PT1H",
      "step": autoSteps.map((step, i) => ({
        "@type": "HowToStep",
        "position": i + 1,
        "name": step.title,
        "text": step.description,
        "itemListElement": step.details.map(d => ({
          "@type": "HowToDirection",
          "text": d,
        })),
      })),
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Call to action">
    <div class="panel-frame overflow-hidden" data-reveal>
      <div class="p-6 sm:p-8">
        <span class="deck-label">Get started</span>
        <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
          Install Catalyst, then import your fleet.
        </h2>
        <p class="mt-3 text-mini sm:text-data text-muted-foreground">
          Deploy Catalyst in about a minute, then import your Pterodactyl data from the admin panel.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={B + "#install"} class="btn btn-md btn-primary">Install panel</a>
          <a href="https://docs.catalystctl.com/" class="btn btn-md btn-outline">Read the docs</a>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="btn btn-md btn-quiet">Join Discord</a>
        </div>
      </div>
    </div>
  </section>

  <div class="h-8"></div>
</Layout>
