# Cloudflare Pages _headers
# Cache static assets aggressively for performance

# Agent discovery (RFC 8288 / RFC 9727)
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json;version=3.0", <https://docs.catalystctl.com/api/reference/>; rel="service-doc", </auth.md>; rel="describedby"; type="text/markdown"

/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=3600

/openapi.json
  Content-Type: application/vnd.oai.openapi+json
  Cache-Control: public, max-age=3600

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Fonts: long cache (1 year), immutable
/_astro/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.woff
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS bundles: long cache, immutable (content-hashed by Vite)
/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.js
  Cache-Control: public, max-age=31536000, immutable

# Images: moderate cache
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-48.png
  Cache-Control: public, max-age=86400

/favicon-192.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/logo-512.png
  Cache-Control: public, max-age=86400

/logo-64.webp
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/og-*.png
  Cache-Control: public, max-age=86400

# HTML pages: short cache, allow revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
