---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";
---

<Layout
  title="About Catalyst"
  description="Catalyst is an open-source game server panel built with Rust and containerd. Meet the project, its principles, and the team behind it."
  canonicalUrl="https://catalystctl.com/about/"
  breadcrumbItems={[{ name: "About" }]}
>
  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-20 left-1/4 h-72 w-72 rounded-full bg-primary/[0.07] blur-3xl" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-4 pt-12 sm:pt-16 pb-20">
      <!-- Hero -->
      <div class="max-w-3xl mb-16" data-speakable>
        <h1 class="font-display font-bold text-foreground tracking-tight text-balance" style="font-size: clamp(2.1rem, 5vw, 3.5rem);">
          Built for hosts who ship.
        </h1>
        <p class="mt-5 text-base sm:text-lg text-zinc-400 leading-relaxed text-pretty">
          Catalyst is an open-source game server panel written in Rust, running on containerd — a drop-in Pterodactyl alternative with sub-10ms console streaming, a plugin system, and a one-line install. Free under GPLv3.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-all hover:bg-primary-600 active:scale-[0.98] min-h-11">
            View on GitHub
          </a>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all hover:bg-surface-2 active:scale-[0.98] min-h-11">
            Join Discord
          </a>
        </div>
      </div>

      <!-- Principles -->
      <section class="mb-16" aria-label="Principles">
        <h2 class="font-display text-xl sm:text-2xl font-semibold text-foreground mb-6">Principles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 p-5">
            <h3 class="font-semibold text-foreground text-sm">Open source, no gates</h3>
            <p class="mt-2 text-sm text-zinc-500 leading-relaxed">GPLv3. Every line is on GitHub. No paid tiers, no feature flags, no telemetry.</p>
          </div>
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 p-5">
            <h3 class="font-semibold text-foreground text-sm">Performance is the product</h3>
            <p class="mt-2 text-sm text-zinc-500 leading-relaxed">Rust backend, containerd runtime, native WebSocket. Sub-10ms console, <1s startup, 50 MB at rest.</p>
          </div>
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 p-5">
            <h3 class="font-semibold text-foreground text-sm">Extensible, not forkable</h3>
            <p class="mt-2 text-sm text-zinc-500 leading-relaxed">Plugin system with hooks, routes, and scheduled tasks — so you never maintain a fork.</p>
          </div>
        </div>
      </section>

      <!-- Team -->
      <section class="mb-16" aria-label="Team">
        <h2 class="font-display text-xl sm:text-2xl font-semibold text-foreground mb-3">Team</h2>
        <p class="text-sm text-zinc-500 leading-relaxed max-w-2xl mb-6">
          Catalyst is built by contributors who run game servers themselves — hosting providers, systems engineers, and players who got tired of PHP + Docker overhead. The project is community-maintained and welcomes contributors.
        </p>
        <div class="rounded-xl border border-zinc-800/60 bg-surface-1/60 px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <p class="text-sm text-zinc-400">Want to contribute? Check the guide on GitHub.</p>
          <a href={GITHUB_URL + "/blob/main/CONTRIBUTING.md"} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-400 transition-colors shrink-0">
            Contributing guide
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          </a>
        </div>
      </section>

      <!-- Project facts -->
      <section class="mb-16" aria-label="Project facts">
        <h2 class="font-display text-xl sm:text-2xl font-semibold text-foreground mb-6">At a glance</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 px-4 py-4 text-center">
            <div class="font-display text-xl font-bold text-foreground">GPLv3</div>
            <div class="text-xs text-zinc-500 mt-1">License</div>
          </div>
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 px-4 py-4 text-center">
            <div class="font-display text-xl font-bold text-foreground">Rust</div>
            <div class="text-xs text-zinc-500 mt-1">Backend</div>
          </div>
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 px-4 py-4 text-center">
            <div class="font-display text-xl font-bold text-foreground">containerd</div>
            <div class="text-xs text-zinc-500 mt-1">Runtime</div>
          </div>
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1 px-4 py-4 text-center">
            <div class="font-display text-xl font-bold text-foreground">60+</div>
            <div class="text-xs text-zinc-500 mt-1">API endpoints</div>
          </div>
        </div>
      </section>

      <!-- Links -->
      <section aria-label="Links">
        <div class="rounded-xl border border-zinc-800/60 overflow-hidden bg-zinc-800/60 grid grid-cols-1 sm:grid-cols-3 gap-px">
          <a href={B + "pterodactyl-alternative/"} class="group bg-surface-1 p-5 transition-colors hover:bg-surface-2">
            <h3 class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">Compare with Pterodactyl</h3>
            <p class="mt-1.5 text-xs text-zinc-500">Architecture, performance, and features side by side.</p>
          </a>
          <a href={B + "docs/"} class="group bg-surface-1 p-5 transition-colors hover:bg-surface-2">
            <h3 class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">Documentation</h3>
            <p class="mt-1.5 text-xs text-zinc-500">Install, configure, and extend the panel.</p>
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="group bg-surface-1 p-5 transition-colors hover:bg-surface-2">
            <h3 class="font-semibold text-foreground text-sm group-hover:text-primary transition-colors">GitHub</h3>
            <p class="mt-1.5 text-xs text-zinc-500">Source, issues, and releases.</p>
          </a>
        </div>
      </section>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Catalyst",
    "url": "https://catalystctl.com/about/",
    "description": "Catalyst is an open-source game server panel built with Rust and containerd — a drop-in Pterodactyl alternative.",
    "mainEntity": {
      "@type": "Organization",
      "@id": "https://catalystctl.com/#organization",
      "name": "Catalyst",
      "url": "https://catalystctl.com/",
      "logo": "https://catalystctl.com/logo-512.png",
      "sameAs": [GITHUB_URL, DISCORD_URL],
    },
  })} />
</Layout>
