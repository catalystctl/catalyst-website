---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/outfit';
import '../styles/global.css';
import githubStats from "../data/github-stats.json";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  schemaType?: "TechArticle" | "BlogPosting" | "Article";
  publishDate?: string;
  modifiedDate?: string;
  keywords?: string[];
  breadcrumbItems?: { name: string; href?: string }[];
  noIndex?: boolean;
}

const {
  title,
  description = "Catalyst replaces Pterodactyl with a faster Rust backend, containerd runtime, and 60+ API endpoints. Deploy game servers in 60 seconds. Free, open source, GPLv3.",
  ogImage,
  canonicalUrl,
  type = "website",
  schemaType,
  publishDate,
  modifiedDate,
  keywords,
  breadcrumbItems,
  noIndex,
} = Astro.props;

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const siteUrl = Astro.site?.toString().replace(/\/+$/, "") || "https://catalystctl.com";
const fullUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
// Avoid "Catalyst - Catalyst" duplication when title already contains brand
const fullTitle = title === "Home"
  ? "Catalyst — Modern Game Server Panel Built with Rust & containerd"
  : title.includes("Catalyst") ? title : `${title} - Catalyst`;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : siteUrl + B + "og-default.png";

const navLinks = [
  { href: B, label: "Home", match: (p: string) => p === B || p === "/" },
  { href: B + "pterodactyl-alternative/", label: "Compare", match: (p: string) => p.includes("pterodactyl-alternative") || p.includes("migrate-from-pterodactyl") },
  { href: B + "blog/", label: "Blog", match: (p: string) => p.includes("/blog") },
  { href: B + "docs/", label: "Docs", match: (p: string) => p.includes("/docs") },
  { href: B + "screenshots/", label: "Screenshots", match: (p: string) => p.includes("/screenshots") },
];

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";
const discordIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>`;

const isArticle = type === "article";
const articleType = schemaType || (isArticle ? "TechArticle" : "Article");

// Determine isPartOf URL based on article context
const isPartOfUrl = Astro.url.pathname.includes("/blog/")
  ? siteUrl + B + "blog/"
  : Astro.url.pathname.includes("/docs/")
    ? siteUrl + B + "docs/"
    : siteUrl + B;
const isPartOfName = Astro.url.pathname.includes("/blog/")
  ? "Catalyst Blog"
  : Astro.url.pathname.includes("/docs/")
    ? "Catalyst Documentation"
    : "Catalyst";

const jsonLd = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": articleType,
      "headline": title,
      "description": description,
      "url": fullUrl,
      "image": ogImageUrl,
      "author": {
        "@type": "Organization",
        "name": "Catalyst",
        "url": GITHUB_URL,
      },
      "publisher": {
        "@type": "Organization",
        "name": "Catalyst",
        "url": GITHUB_URL,
        "logo": {
          "@type": "ImageObject",
          "url": siteUrl + B + "logo-512.png",
          "width": 512,
          "height": 512,
        },
      },
      ...(publishDate && { "datePublished": publishDate }),
      ...(modifiedDate && { "dateModified": modifiedDate }),
      ...(publishDate && !modifiedDate && { "dateModified": publishDate }),
      "isPartOf": {
        "@type": "WebSite",
        "name": isPartOfName,
        "url": isPartOfUrl,
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": fullUrl,
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", ".doc p:first-of-type", "[data-speakable]"],
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Catalyst",
      "description": description,
      "url": siteUrl + import.meta.env.BASE_URL,
      "applicationCategory": "ServerApplication",
      "operatingSystem": "Linux",
      "image": ogImageUrl,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
      "programmingLanguage": ["TypeScript", "Rust"],
      "license": "https://www.gnu.org/licenses/gpl-3.0.en.html",
      "codeRepository": GITHUB_URL,
      "featureList": [
        "Real-time console streaming via WebSocket",
        "containerd runtime for superior performance",
        "RBAC with 20+ granular permissions",
        "60+ REST API endpoints",
        "Plugin system for extensibility",
        "Automatic crash detection and recovery",
      ],
    };

// Global Organization + WebSite entity graph (homepage or any page — idempotent via @id)
const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === B;
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": siteUrl + "/#organization",
  "name": "Catalyst",
  "url": siteUrl + B,
  "logo": {
    "@type": "ImageObject",
    "url": siteUrl + B + "logo-512.png",
    "width": 512,
    "height": 512,
  },
  "sameAs": [GITHUB_URL, DISCORD_URL],
};
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteUrl + "/#website",
  "name": "Catalyst",
  "url": siteUrl + B,
  "publisher": { "@id": siteUrl + "/#organization" },
  "inLanguage": "en-US",
};

const breadcrumbLd = breadcrumbItems && breadcrumbItems.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": siteUrl + import.meta.env.BASE_URL,
        },
        ...breadcrumbItems.map((item, i) => ({
          "@type": "ListItem",
          "position": i + 2,
          "name": item.name,
          ...(item.href && { "item": siteUrl + import.meta.env.BASE_URL + item.href.replace(/^\//, "") }),
        })),
      ],
    }
  : null;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, follow" : "index, follow"} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={fullUrl} />

    <link rel="icon" type="image/svg+xml" href={B + "favicon.svg"} />
    <link rel="icon" href={B + "favicon.ico"} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href={B + "favicon-48.png"} />
    <link rel="icon" type="image/png" sizes="192x192" href={B + "favicon-192.png"} />
    <link rel="apple-touch-icon" href={B + "apple-touch-icon.png"} />
    <link rel="manifest" href={B + "site.webmanifest"} />
    <meta name="theme-color" content="#0b0a08" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Catalyst" />
    <meta property="og:locale" content="en_US" />
    {isArticle && publishDate && <meta property="article:published_time" content={publishDate} />}
    {isArticle && <meta property="article:author" content="Catalyst Team" />}
    {isArticle && <meta property="article:section" content="Documentation" />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={fullTitle} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="sticky top-0 z-50 border-b border-zinc-800/80 bg-surface-1/70 backdrop-blur-xl">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
        <a href={B} class="flex items-center gap-2.5 shrink-0 group" aria-label="Catalyst home">
          <img src={B + "logo-64.webp"} alt="Catalyst logo" class="h-7 w-7 rounded-lg ring-1 ring-zinc-800 group-hover:ring-primary/40 transition-all" width={28} height={28} loading="eager" decoding="async" />
          <span class="font-display text-base font-semibold text-zinc-100 tracking-tight">Catalyst</span>
        </a>

        <nav class="hidden md:flex items-center gap-0.5" aria-label="Main navigation">
          {navLinks.map((link) => {
            const active = link.match(path);
            return (
              <a
                href={link.href}
                class:list={[
                  "relative rounded-lg px-3 py-2 text-sm font-medium transition-all duration-200",
                  active
                    ? "text-foreground"
                    : "text-zinc-500 hover:text-zinc-200 hover:bg-surface-2/80",
                ]}
              >
                {link.label}
                {active && (
                  <span class="absolute inset-x-2 -bottom-[calc(0.5rem+1px)] h-0.5 rounded-full bg-primary" aria-hidden="true"></span>
                )}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={B + "#install"}
            class="hidden sm:inline-flex items-center gap-1.5 rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow-[0_0_0_1px_hsl(29_47%_50%/0.25),0_6px_20px_-8px_hsl(29_47%_56%/0.4)] transition-all duration-200 hover:bg-primary-600 active:scale-[0.98]"
          >
            Install in 60s
          </a>
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:inline-flex items-center justify-center rounded-lg border border-zinc-800 p-2 text-zinc-400 transition-colors h-9 hover:text-zinc-100 hover:bg-surface-2 hover:border-zinc-700"
            aria-label="Join Catalyst on Discord"
          >
            <Fragment set:html={discordIcon} />
          </a>
          <a
            href={githubStats.latestRelease?.url ?? GITHUB_URL + "/releases"}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-zinc-800 px-2.5 py-1.5 text-zinc-400 transition-colors hover:text-zinc-100 hover:bg-surface-2 hover:border-zinc-700"
            aria-label={`Latest release ${githubStats.latestRelease?.tag ?? ""} on GitHub`}
            title="Latest release"
          >
            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span class="font-mono text-[11px] font-medium text-zinc-300">{githubStats.latestRelease?.tag ?? "releases"}</span>
          </a>
          <button id="mobile-nav-btn" type="button" class="md:hidden min-h-11 min-w-11 flex items-center justify-center rounded-lg border border-zinc-800 text-zinc-400 hover:text-zinc-200" aria-label="Open menu" aria-expanded="false">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
          </button>
        </div>
      </div>
    </header>

    <div id="mobile-nav-drawer" class="fixed inset-0 z-[60] hidden">
      <div id="mobile-nav-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="absolute right-0 top-0 bottom-0 w-72 bg-surface-0 border-l border-zinc-800/60 shadow-2xl shadow-black/50">
        <div class="flex items-center justify-between px-4 h-14 border-b border-zinc-800/60">
          <span class="font-display text-sm font-semibold text-zinc-200">Menu</span>
          <button id="mobile-nav-close" type="button" class="min-h-11 min-w-11 flex items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-200" aria-label="Close menu">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <nav class="p-4 space-y-1" aria-label="Mobile navigation">
          {navLinks.map((link) => {
            const active = link.match(path);
            return (
              <a
                href={link.href}
                class:list={[
                  "block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors",
                  active
                    ? "bg-primary/15 text-primary border border-primary/25"
                    : "text-zinc-400 hover:bg-surface-2 hover:text-zinc-100",
                ]}
              >
                {link.label}
              </a>
            );
          })}
          <div class="h-px bg-zinc-800/60 my-3"></div>
          <a
            href={B + "#install"}
            class="flex items-center justify-center gap-2 rounded-lg bg-primary px-3 py-2.5 text-sm font-semibold text-primary-foreground"
          >
            Install in 60s
          </a>
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-400 hover:bg-surface-2 hover:text-zinc-100 transition-colors"
          >
            <span class="text-zinc-500"><Fragment set:html={discordIcon} /></span>
            Discord
          </a>
          <a
            href={githubStats.latestRelease?.url ?? GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-zinc-400 hover:bg-surface-2 hover:text-zinc-100 transition-colors"
          >
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
            {githubStats.latestRelease?.tag && (
              <span class="ml-auto font-mono text-[11px] text-zinc-600">{githubStats.latestRelease.tag}</span>
            )}
          </a>
        </nav>
      </div>
    </div>

    <script>
      (function() {
        const drawer = document.getElementById('mobile-nav-drawer');
        const backdrop = document.getElementById('mobile-nav-backdrop');
        const openBtn = document.getElementById('mobile-nav-btn');
        const closeBtn = document.getElementById('mobile-nav-close');
        function open() { drawer?.classList.remove('hidden'); openBtn?.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; }
        function close() { drawer?.classList.add('hidden'); openBtn?.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; }
        openBtn?.addEventListener('click', open);
        closeBtn?.addEventListener('click', close);
        backdrop?.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer?.classList.contains('hidden')) close(); });
      })();
    </script>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-zinc-800/80">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
          <div class="sm:col-span-2 lg:col-span-1">
            <a href={B} class="inline-flex items-center gap-2.5 mb-4">
              <img src={B + "logo-64.webp"} alt="Catalyst" class="h-6 w-6 rounded-md" width={24} height={24} loading="lazy" decoding="async" />
              <span class="font-display text-sm font-semibold text-zinc-100">Catalyst</span>
            </a>
            <p class="text-sm text-zinc-500 leading-relaxed max-w-xs">
              Modern game server panel. Rust backend, containerd runtime, GPLv3.
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-2">
              <a
                href={B + "#install"}
                class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground transition-all hover:bg-primary-600 active:scale-[0.98]"
              >
                Install in 60s
              </a>
              <a
                href={DISCORD_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-800 px-3 py-2 text-xs font-medium text-zinc-400 transition-all hover:bg-surface-2 hover:text-zinc-200 hover:border-zinc-700"
              >
                <span class="opacity-80"><Fragment set:html={discordIcon} /></span>
                Discord
              </a>
            </div>
          </div>

          <div>
            <h2 class="text-xs font-semibold text-zinc-300 mb-3">Product</h2>
            <ul class="space-y-2">
              <li><a href={B + "pterodactyl-alternative/"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Compare</a></li>
              <li><a href={B + "migrate-from-pterodactyl/"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Migrate</a></li>
              <li><a href={B + "screenshots/"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Screenshots</a></li>
              <li><a href={B + "#install"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Install</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-semibold text-zinc-300 mb-3">Resources</h2>
            <ul class="space-y-2">
              <li><a href={B + "docs/"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Docs</a></li>
              <li><a href={B + "blog/"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Blog</a></li>
              <li><a href="https://github.com/catalystctl/catalyst/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Contributing</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-semibold text-zinc-300 mb-3">Community</h2>
            <ul class="space-y-2">
              <li><a href={B + "about/"} class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">About</a></li>
              <li><a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">Discord</a></li>
              <li><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">GitHub</a></li>
              <li><a href="https://github.com/catalystctl/catalyst/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors">GPLv3 License</a></li>
            </ul>
          </div>
        </div>

