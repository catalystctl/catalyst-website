---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";

const AUDIENCE_LABELS: Record<string, string> = {
  hobbyists: "Hobbyists",
  businesses: "Businesses",
  "hosting-providers": "Hosting Providers",
  enterprises: "Enterprises",
};

const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedFormattedDate = entry.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  schemaType="BlogPosting"
  publishDate={entry.data.pubDate.toISOString()}
  modifiedDate={entry.data.updatedDate?.toISOString()}
  ogImage={entry.data.ogImage}
  canonicalUrl={`https://catalystctl.com/blog/${entry.id}/`}
  keywords={entry.data.keywords}
  breadcrumbItems={[{ name: "Blog", href: "blog/" }, { name: entry.data.title }]}
>
  <article>
    <div class="max-w-3xl mx-auto px-4 sm:px-8 pt-10 sm:pt-14 pb-16 sm:pb-20">
      <nav class="mb-6 flex items-center gap-1.5 font-mono text-micro text-muted-foreground/70" aria-label="Breadcrumb">
        <a href={B} class="hover:text-foreground transition-colors">Home</a>
        <span class="text-muted-foreground/40">/</span>
        <a href={B + "blog/"} class="hover:text-foreground transition-colors">Blog</a>
        <span class="text-muted-foreground/40">/</span>
        <span class="line-clamp-1">{entry.data.title}</span>
      </nav>

      <header class="mb-8">
        {entry.data.audience && entry.data.audience.length > 0 && (
          <div class="mb-3 flex flex-wrap items-center gap-1.5">
            {entry.data.audience.map((a) => (
              <span class="inline-flex items-center rounded-sm border border-primary/25 bg-primary/10 px-2 py-0.5 font-mono text-micro text-primary">
                {AUDIENCE_LABELS[a] || a}
              </span>
            ))}
          </div>
        )}

        <h1 class="font-display text-[1.75rem] sm:text-[2.25rem] font-semibold text-foreground leading-[1.14] tracking-tight text-balance">
          {entry.data.title}
        </h1>
        <p class="mt-3 text-data sm:text-base text-muted-foreground leading-relaxed max-w-2xl text-pretty">
          {entry.data.description}
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-micro text-muted-foreground">
          <span class="text-chalk/85">{entry.data.author}</span>
          <span class="text-muted-foreground/40">/</span>
          <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
          {updatedFormattedDate && (
            <>
              <span class="text-muted-foreground/40">/</span>
              <span class="text-muted-foreground/70">Updated {updatedFormattedDate}</span>
            </>
          )}
        </div>
      </header>

      <div class="rule mb-8" aria-hidden="true"></div>

      <div class="doc">
        <slot />
      </div>

      {entry.data.faqs && entry.data.faqs.length > 0 && (
        <section class="mt-14" aria-label="Frequently asked questions" data-speakable>
          <span class="deck-label">FAQ</span>
          <h2 id="faq" class="mt-3 font-display text-xl sm:text-2xl font-semibold text-foreground tracking-tight text-balance">
            Frequently asked questions.
          </h2>
          <p class="mt-2 text-mini text-muted-foreground leading-relaxed max-w-prose">
            Short answers to the questions people ask most about this topic.
          </p>
          <div class="mt-5 deck-panel overflow-hidden grid grid-cols-1 gap-px bg-border/40">
            {entry.data.faqs.map((faq) => (
              <details class="faq-item group bg-card">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3.5">
                  <h3 class="text-data font-medium text-foreground leading-snug pr-2">{faq.q}</h3>
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm border border-border/70 text-muted-foreground transition-colors group-open:border-primary/40 group-open:text-primary group-open:bg-primary/10">
                    <svg class="w-3 h-3 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                  </span>
                </summary>
                <p class="px-4 pb-4 text-mini text-muted-foreground leading-relaxed max-w-prose">{faq.a}</p>
              </details>
            ))}
          </div>

          <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": entry.data.faqs.map((faq) => ({
              "@type": "Question",
              "name": faq.q,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.a,
              },
            })),
          })} />
        </section>
      )}

      <div class="mt-14 panel-frame overflow-hidden">
        <div class="deck-toolbar justify-between">
          <span class="deck-label">Get started</span>
          <span class="deck-keyhint">GPLv3 · no feature gates</span>
        </div>
        <div class="p-5 sm:p-6">
          <h2 class="font-display text-lg font-semibold text-foreground">Install the panel on your own hardware.</h2>
          <p class="mt-2 text-mini text-muted-foreground max-w-md">One command brings up the panel, PostgreSQL, and Redis.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={B + "#install"} class="btn btn-md btn-primary">Install panel</a>
            <a href={B + "pterodactyl-alternative/"} class="btn btn-md btn-outline">Open comparison</a>
            <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="btn btn-md btn-quiet">Join Discord</a>
          </div>
        </div>
      </div>

      <nav class="mt-10 pt-6 border-t border-border/60 flex flex-wrap items-center justify-between gap-4">
        <a href={B + "blog/"} class="inline-flex items-center gap-1.5 text-mini text-muted-foreground hover:text-foreground transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
          All posts
        </a>
        <div class="flex flex-wrap items-center gap-4">
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="text-mini text-muted-foreground/70 hover:text-foreground transition-colors">
            Discord
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-mini text-muted-foreground/70 hover:text-foreground transition-colors">
            Source on GitHub
          </a>
        </div>
      </nav>
    </div>
  </article>
</Layout>
