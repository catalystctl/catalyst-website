---
export const prerender = true;

import Layout from "../layouts/Layout.astro";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";

const autoSteps = [
  {
    number: "1",
    title: "Deploy Catalyst",
    description: "Install on the target host with the one-line script. Compose, secrets, and panel bootstrap land automatically.",
    details: [
      "curl -fsSL https://raw.githubusercontent.com/catalystctl/catalyst/main/install.sh | bash",
      "Edit the generated .env and set PUBLIC_URL",
      "docker compose up -d for panel, API, and database",
      "Provision a Catalyst node and confirm it is online",
    ],
  },
  {
    number: "2",
    title: "Connect Pterodactyl",
    description: "Create API keys on the old panel and verify reachability from Catalyst Admin → Migration.",
    details: [
      "Create an Application API key (ptla_*) with full read access",
      "Create a Client API key (ptlc_*) for files and backups",
      "Enter the Pterodactyl URL and keys in Catalyst",
      "Run Test Connection before you import anything",
    ],
  },
  {
    number: "3",
    title: "Map nodes and migrate",
    description: "Pick full, node, or server scope. Map nodes, start the job, and watch per-server progress.",
    details: [
      "Choose scope: full, node, or individual servers",
      "Map each Pterodactyl node to a Catalyst node",
      "Start Migration to import users, eggs, allocations, and servers",
      "Monitor steps, status, and retries in real time",
    ],
  },
  {
    number: "4",
    title: "Verify and cut over",
    description: "Boot a few servers, check files, flip DNS, then wind down Pterodactyl.",
    details: [
      "Start a migrated server and watch the Catalyst console",
      "Confirm ownership, permissions, and configs",
      "Point DNS A records at the Catalyst panel",
      "Stop Pterodactyl and watch Catalyst logs for 24-48 hours",
    ],
  },
];

const migratedItems = [
  {
    title: "Nodes and allocations",
    description: "Pterodactyl nodes map to Catalyst nodes. IP allocations and port ranges recreate automatically.",
  },
  {
    title: "Users and roles",
    description: "Accounts, emails, and passwords import. Basic admin/user roles land in Catalyst RBAC for you to refine.",
  },
  {
    title: "Eggs and templates",
    description: "Eggs become Catalyst templates. Variables, images, install scripts, and startup commands transfer as-is.",
  },
  {
    title: "Servers and files",
    description: "Specs, env vars, and ports recreate. File data streams from Pterodactyl volumes into containerd storage.",
  },
];

const faqs = [
  {
    q: "Will my Pterodactyl eggs work in Catalyst?",
    a: "Yes. The migration tool converts eggs to Catalyst templates. Startup commands, env vars, and install scripts usually transfer clean. Review any Docker Compose-only bits because Catalyst talks to containerd.",
  },
  {
    q: "Can I run Catalyst and Pterodactyl side by side?",
    a: "Yes during cutover. Use a separate host or different ports with non-overlapping allocations so you can validate before DNS flips.",
  },
  {
    q: "What happens to my existing server files?",
    a: "Files stream from Pterodactyl Docker volumes into Catalyst storage. Layout stays intact and the built-in file manager helps you verify.",
  },
  {
    q: "How long does migration take?",
    a: "Config (users, eggs, nodes, allocations, metadata) finishes in minutes. File transfer scales with data size and network. Under 50 servers often lands in under an hour.",
  },
  {
    q: "Is there an automatic migration tool?",
    a: "Yes. Admin → Migration imports nodes, allocations, users, eggs, servers, and files. You can pause, resume, and retry steps.",
  },
  {
    q: "Can I migrate only some servers?",
    a: "Yes. Scopes are full, node, or server. Run multiple jobs or retry failed steps without starting over.",
  },
];

const compatibility = [
  {
    title: "Eggs and startup commands",
    body: "Templates mirror eggs conceptually. The tool converts them automatically. Review Docker Compose-specific config because Catalyst uses containerd directly.",
  },
  {
    title: "Server files and volumes",
    body: "Pterodactyl keeps files under /var/lib/pterodactyl/volumes. Catalyst streams them into containerd snapshotter storage and preserves layout.",
  },
  {
    title: "Users and permissions",
    body: "Admin/user roles map cleanly, then you can tighten them with Catalyst's 20+ permissions after import.",
  },
  {
    title: "API integrations",
    body: "The REST surface differs from Pterodactyl but is broader. Update bots and billing scripts to the 60+ Catalyst endpoints.",
  },
];
---

<Layout
  title="Migrate from Pterodactyl to Catalyst"
  description="Migrate from Pterodactyl to Catalyst automatically. Import nodes, users, eggs, servers, and files with Catalyst's built-in migration tool."
  canonicalUrl="https://catalystctl.com/migrate-from-pterodactyl/"
  breadcrumbItems={[{ name: "Pterodactyl Alternative", href: "pterodactyl-alternative/" }, { name: "Migrate" }]}
>
  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));
  </script>

  <!-- Hero -->
  <section class="relative overflow-hidden" aria-label="Migration overview">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -top-20 right-0 h-72 w-72 glow-orb text-primary/[0.08]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 pt-10 sm:pt-14 pb-8">
      <nav class="text-xs text-zinc-600 mb-6" aria-label="Breadcrumb">
        <a href={B} class="hover:text-zinc-400 transition-colors">Home</a>
        <span class="mx-1.5 text-zinc-700">/</span>
        <a href={B + "pterodactyl-alternative/"} class="hover:text-zinc-400 transition-colors">Compare</a>
        <span class="mx-1.5 text-zinc-700">/</span>
        <span class="text-zinc-400">Migrate</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end" data-reveal>
        <div class="lg:col-span-7">
          <h1 class="font-display font-bold text-foreground tracking-tight leading-[1.08] text-balance" style="font-size: clamp(2.1rem, 5.5vw, 3.75rem);">
            Migrate from <span class="text-zinc-500">Pterodactyl</span> without a rewrite.
          </h1>
          <p class="mt-5 max-w-xl text-base sm:text-lg text-zinc-400 leading-relaxed text-pretty">
            Built-in auto-migration imports nodes, users, eggs, servers, and files from the admin panel. No hand-rolled scripts.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={B + "#install"} class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:bg-primary-600 active:scale-[0.98] min-h-11 shadow-[0_0_0_1px_hsl(29_47%_50%/0.3),0_8px_28px_-8px_hsl(29_47%_56%/0.45)]">
              Install in 60s
            </a>
            <a href={B + "pterodactyl-alternative/#comparison"} class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-200 transition-all duration-200 hover:bg-surface-2 active:scale-[0.98] min-h-11">
              Open comparison
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-xl border border-zinc-800/60 bg-surface-1/80 divide-y divide-zinc-800/50">
            <div class="p-4 flex items-baseline justify-between gap-3">
              <span class="text-sm text-zinc-500">Typical under 50 servers</span>
              <span class="font-display text-xl font-bold text-foreground tabular-nums">&lt;1 hour</span>
            </div>
            <div class="p-4 flex items-baseline justify-between gap-3">
              <span class="text-sm text-zinc-500">Fresh panel install</span>
              <span class="font-display text-xl font-bold text-foreground tabular-nums">60s</span>
            </div>
            <div class="p-4 flex items-baseline justify-between gap-3">
              <span class="text-sm text-zinc-500">Import path</span>
              <span class="font-display text-xl font-bold text-primary">Auto</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Auto migration callout -->
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="relative rounded-2xl border border-primary/25 overflow-hidden p-6 sm:p-8 lg:p-10" data-reveal>
      <div class="absolute inset-0 bg-gradient-to-br from-primary/[0.12] via-surface-1 to-surface-0 pointer-events-none"></div>
      <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-7">
          <h2 class="font-display text-xl sm:text-2xl font-semibold text-foreground tracking-tight">
            Built-in auto migration
          </h2>
          <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-xl">
            Connect the Pterodactyl API, choose what to import, and Catalyst handles nodes, allocations, users, eggs, servers, and file data. Pause, resume, or retry any step.
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-wrap content-start gap-2">
          {["Nodes and allocations", "Users and roles", "Eggs and templates", "Servers and files"].map((t) => (
            <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Steps: vertical timeline -->
  <section class="max-w-6xl mx-auto px-4 py-16" aria-label="Migration steps">
    <div class="mb-10 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Four steps to a clean cutover.
      </h2>
    </div>

    <div class="relative" data-reveal>
      <div class="hidden sm:block absolute left-[1.35rem] top-4 bottom-4 w-px bg-gradient-to-b from-primary/50 via-zinc-800 to-zinc-800" aria-hidden="true"></div>
      <div class="space-y-4">
        {autoSteps.map((step) => (
          <div class="relative sm:pl-14">
            <div class="hidden sm:flex absolute left-0 top-5 h-11 w-11 items-center justify-center rounded-xl border border-primary/30 bg-surface-1 text-primary font-display text-sm font-bold shadow-[0_0_0_4px_hsl(0_0%_4%)]">
              {step.number}
            </div>
            <div class="rounded-xl border border-zinc-800/60 bg-surface-1 p-5 sm:p-6">
              <div class="flex items-center gap-3 sm:hidden mb-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/15 text-primary font-display text-sm font-bold">{step.number}</span>
              </div>
              <h3 class="font-display text-lg font-semibold text-foreground">{step.title}</h3>
              <p class="mt-1.5 text-sm text-zinc-400 leading-relaxed">{step.description}</p>
              <ul class="mt-4 space-y-2">
                {step.details.map((d) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-primary/70 shrink-0" aria-hidden="true"></span>
                    <span class="font-mono text-[12px] text-zinc-400 leading-relaxed">{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What migrates -->
  <section class="max-w-6xl mx-auto px-4 py-16" aria-label="What gets migrated">
    <div class="mb-8 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        What lands on the other side.
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-px rounded-xl border border-zinc-800/60 overflow-hidden bg-zinc-800/60" data-reveal-stagger>
      {migratedItems.map((item) => (
        <div class="bg-surface-1 p-6">
          <h3 class="font-semibold text-foreground text-[15px]">{item.title}</h3>
          <p class="mt-2 text-sm text-zinc-500 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Compatibility -->
  <section class="max-w-6xl mx-auto px-4 py-16" aria-label="Compatibility notes">
    <div class="max-w-3xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight mb-6 text-balance">
        Compatibility at a glance
      </h2>
      <div>
        {compatibility.map((item) => (
          <div class="border-b border-zinc-800/50 py-6 first:pt-0 last:border-0">
            <h3 class="text-foreground font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ details -->
  <section class="max-w-6xl mx-auto px-4 py-16" aria-label="Migration FAQ">
    <div class="mb-10 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Common migration questions.
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12" data-reveal>
      {faqs.map((faq) => (
        <details class="faq-item group border-b border-zinc-800/50 py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left">
            <h3 class="font-semibold text-foreground text-[15px] leading-snug pr-2">{faq.q}</h3>
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-zinc-800 text-zinc-500 transition-colors group-open:border-primary/40 group-open:text-primary group-open:bg-primary/10">
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </span>
          </summary>
          <p class="mt-3 text-sm text-zinc-500 leading-relaxed max-w-prose pr-10">{faq.a}</p>
        </details>
      ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Migrate from Pterodactyl to Catalyst",
      "description": "Migrate your Pterodactyl nodes, users, eggs, servers, and files to Catalyst using the built-in auto-migration tool.",
      "totalTime": "PT1H",
      "step": autoSteps.map((step, i) => ({
        "@type": "HowToStep",
        "position": i + 1,
        "name": step.title,
        "text": step.description,
        "itemListElement": step.details.map(d => ({
          "@type": "HowToDirection",
          "text": d,
        })),
      })),
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 py-16" aria-label="Call to action">
    <div class="relative rounded-2xl border border-primary/20 overflow-hidden p-8 sm:p-12" data-reveal>
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute inset-x-0 top-0 h-56 hero-glow"></div>
        <div class="absolute top-0 right-0 w-80 h-80 glow-orb text-primary/[0.12]"></div>
        <div class="absolute bottom-0 left-0 w-56 h-56 glow-orb text-primary/[0.05]"></div>
      </div>
      <div class="relative max-w-xl">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-foreground tracking-tight text-balance">
          Start the migration tonight.
        </h2>
        <p class="mt-3 text-base text-zinc-400">
          Deploy Catalyst in a minute, then import your Pterodactyl data from the admin panel.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={B + "#install"} class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:bg-primary-600 active:scale-[0.98] min-h-11 shadow-[0_0_0_1px_hsl(29_47%_50%/0.3),0_8px_28px_-8px_hsl(29_47%_56%/0.45)]">
            Install in 60s
          </a>
          <a href={B + "docs/"} class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all duration-200 hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98] min-h-11">
            Read the docs
          </a>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all duration-200 hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98] min-h-11">
            Join Discord
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="h-8"></div>
</Layout>
