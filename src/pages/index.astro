---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import githubStats from "../data/github-stats.json";
import { formatCount } from "../lib/github-stats.mjs";
import HeroPanel from "../components/HeroPanel.astro";
import FleetDeck from "../components/FleetDeck.astro";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";
const DEMO_URL = "https://demo.catalystctl.com/";
const INSTALL_CMD = "curl -fsSL https://raw.githubusercontent.com/catalystctl/catalyst/main/install.sh | bash";

const steps = [
  {
    n: "01",
    title: "Install the panel.",
    body: "One script brings up panel, PostgreSQL, and Redis via Docker Compose. Secrets generated, TLS-ready reverse-proxy examples included.",
    code: "$ curl -fsSL … | bash",
  },
  {
    n: "02",
    title: "Add a node.",
    body: "Point it at any Linux box with containerd. The node agent is a single static Rust binary that talks directly to containerd.",
    code: "agent ▸ registered · containerd native",
  },
  {
    n: "03",
    title: "Deploy from a template.",
    body: "258 egg definitions across 167 games, including Minecraft Java/Bedrock, CS2, ARK, Terraria, Valheim, and Palworld. Custom templates, console, files, and backups are included.",
    code: "> Server created · console streaming live",
  },
];

const bigStats = [
  { value: "Live", label: "Console, files, and metrics", hint: "WebSocket console via panel gateway to the Rust agent, plus SFTP and file manager.", live: true, meter: null },
  { value: "1 cmd", label: "Panel install", hint: "One script with Docker Compose for panel, PostgreSQL, and Redis.", live: false, meter: null },
  { value: "200+", label: "API route handlers", hint: "Fastify + Prisma across servers, nodes, users, files, backups, and plugins. RBAC-aware.", live: false, meter: null },
  { value: "50+", label: "Granular RBAC permissions", hint: "Roles across servers, nodes, templates, users, backups, files, and alerts.", live: false, meter: null },
];

const features = [
  {
    title: "Create Server",
    description: "Deploy from a template in seconds with automatic environment provisioning.",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>`,
  },
  {
    title: "Enterprise Security",
    description: "RBAC with 50+ permissions, scoped expiring API keys, audit logging, 2FA/passkey, and TLS-ready defaults.",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  },
  {
    title: "Register Node",
    description: "Add bare-metal or VM nodes with the containerd-native Rust agent (single static binary).",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>`,
  },
  {
    title: "Plugin System",
    description: "Extend the API with custom routes, hooks, and scheduled background tasks.",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>`,
  },
  {
    title: "View Alerts",
    description: "Customizable alerts and monitoring dashboards across every node in your fleet.",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>`,
  },
  {
    title: "Scheduled Tasks",
    description: "Automate restarts, backups, and maintenance windows with built-in cron scheduling.",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    title: "Audit Logging",
    description: "Every administrative action recorded with actor, IP, and timestamp.",
    icon: `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>`,
  },
];

const comparison = [
  { feature: "Runtime (nodes)", catalyst: "containerd (native)", pterodactyl: "Docker via Wings", winner: "catalyst" },
  { feature: "Backend", catalyst: "TypeScript (Fastify) + Rust agent", pterodactyl: "PHP (Laravel) + Go (Wings)", winner: "tie" },
  { feature: "Live console", catalyst: "WebSocket via panel + agent", pterodactyl: "Live console via Wings", winner: "tie" },
  { feature: "API endpoints", catalyst: "200+ route handlers", pterodactyl: "REST API", winner: "catalyst" },
  { feature: "Plugin system", catalyst: "Native hooks + routes", pterodactyl: "No native plugin API", winner: "catalyst" },
  { feature: "RBAC permissions", catalyst: "50+ granular", pterodactyl: "Basic roles", winner: "catalyst" },
  { feature: "Install", catalyst: "Single-script panel", pterodactyl: "Manual panel + Wings", winner: "catalyst" },
];

const gh = githubStats;

const faqs = [
  {
    q: "Is Catalyst a Pterodactyl replacement?",
    a: "It covers the same core use cases (game server management, node orchestration, user panel, admin dashboard) with a TypeScript panel, Rust node agent, containerd runtime, and native plugin system. Use the built-in migration tool to import from Pterodactyl.",
  },
  {
    q: "How is Catalyst different from Pterodactyl?",
    a: "Catalyst pairs a TypeScript Fastify panel (PostgreSQL + Redis) with a Rust agent that talks directly to containerd, and ships 200+ API route handlers. You also get a native plugin system, live WebSocket console, SFTP/file manager, and RBAC with 50+ granular permissions.",
  },
  {
    q: "Can I migrate from Pterodactyl to Catalyst?",
    a: "Yes. Catalyst has a built-in migration job that imports nodes, users, eggs as templates, servers, and files from Pterodactyl. Most Pterodactyl Docker images run under containerd, but review Docker-specific bits first.",
  },
  {
    q: "Is Catalyst free and open source?",
    a: "Yes. The panel is GPLv3 and the node agent is MIT/Apache-2.0. Panel, agent, frontend, and docs are on GitHub. No paid tiers or feature gates. Note: the project is in early testing.",
  },
  {
    q: "What games does Catalyst support?",
    a: "258 egg definitions across 167 games cover Minecraft Java/Bedrock, Counter-Strike 2, ARK Ascended/Evolved, Terraria, Valheim, Palworld, Factorio, and Rust. Custom templates support variables, images, and install scripts.",
  },
  {
    q: "What are the system requirements?",
    a: "Panel: any Linux server with Docker and Docker Compose (panel + PostgreSQL + Redis). Nodes: Linux with containerd and the Catalyst agent (root for containerd socket, CNI, and firewall).",
  },
];

const archLayers = [
  { name: "Your game server", detail: "Minecraft · CS2 · ARK · 258 eggs", tone: "dim" },
  { name: "Catalyst", detail: "Panel (TypeScript) + agent (Rust) · console · files · RBAC", tone: "hl" },
  { name: "containerd (nodes)", detail: "Native runtime on game nodes. Panel itself ships via Docker.", tone: "" },
  { name: "Linux", detail: "Panel: Docker hosts · Nodes: containerd + root", tone: "dim" },
];

const ciTone = gh.ci?.state === "passing" ? "success" : gh.ci?.state === "failing" ? "danger" : "generic";
---

<Layout title="Home" description="Catalyst is an open-source game server panel with a TypeScript panel, Rust node agent, and containerd runtime. 200+ API route handlers, 50+ RBAC permissions, 258 egg definitions. Early testing.">

  <!-- ═══ HERO ═══ -->
  <section aria-label="Catalyst overview">
    <div class="max-w-6xl mx-auto px-4 pt-12 sm:pt-16 pb-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-2" data-reveal>
            <span class="led-wrap"><span class="led-pulse bg-success"></span><span class="led bg-success"></span></span>
            <span class="type-overline">Open source · GPLv3 · early testing</span>
          </div>

          <h1 class="mt-4 font-display text-[2rem] sm:text-[2.6rem] font-semibold text-foreground tracking-tight leading-[1.1] text-balance" data-reveal>
            The open-source game server panel built on <span class="text-primary">containerd.</span>
          </h1>

          <p class="mt-4 max-w-lg text-data sm:text-base text-muted-foreground leading-relaxed" data-reveal>
            An open-source game server panel built on a TypeScript panel, a Rust node agent, and a containerd-native runtime. Live console, file manager, and a one-command panel install.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-2" data-reveal>
            <a href="#install" class="btn btn-md btn-primary">
              Install Catalyst
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-md btn-outline">
              GitHub
              <svg class="w-3.5 h-3.5 text-muted-foreground" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            </a>
            <a href={DEMO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-md btn-quiet">
              Live demo
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            </a>
          </div>

          <p class="mt-5 font-mono text-micro text-muted-foreground/70" data-reveal>
            panel <span class="text-muted-foreground/40">(TypeScript)</span> → agent <span class="text-muted-foreground/40">(Rust)</span> → <span class="text-primary/80">containerd</span>
          </p>
        </div>

        <!-- Install console + live status: the panel's ruled surface language -->
        <div class="lg:col-span-5 w-full" data-reveal>
          <div class="deck-panel overflow-hidden">
            <div class="deck-toolbar justify-between">
              <span class="deck-label">Install</span>
              <button class="copy-btn" data-copy={INSTALL_CMD} aria-label="Copy install command">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5" /></svg>
                Copy
              </button>
            </div>
            <div class="px-3 py-3 font-mono text-micro sm:text-mini bg-surface-0 overflow-x-auto">
              <span class="text-primary select-none">$</span> <span class="text-chalk/85 break-all">{INSTALL_CMD}</span>
            </div>
          </div>

          <div class="deck-panel deck-statusbar mt-2 overflow-hidden">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              <a href={`${gh.repoUrl}/commits/main`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-foreground">
                <span class="led bg-muted-foreground/50"></span>
                <span class="font-mono text-micro tabular-nums text-muted-foreground">{formatCount(gh.commits) ?? "?"}</span>
                <span class="type-overline">Commits</span>
              </a>
              <a href={`${gh.repoUrl}/releases`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-foreground">
                <span class="led bg-muted-foreground/50"></span>
                <span class="font-mono text-micro tabular-nums text-muted-foreground">{formatCount(gh.releases) ?? "?"}</span>
                <span class="type-overline">Releases</span>
              </a>
              <a href={gh.ci?.url ?? `${gh.repoUrl}/actions`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-foreground">
                <span class={`led bg-${ciTone === "generic" ? "muted-foreground/50" : ciTone}`}></span>
                <span class="type-overline">CI {gh.ci?.label ?? "unknown"}</span>
              </a>
              <a href={`${gh.repoUrl}/graphs/contributors`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-foreground">
                <span class="led bg-muted-foreground/50"></span>
                <span class="font-mono text-micro tabular-nums text-muted-foreground">{formatCount(gh.contributors) ?? "?"}</span>
                <span class="type-overline">Contributors</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live panel -->
    <div class="max-w-6xl mx-auto px-4 mt-4" data-reveal>
      <HeroPanel />
    </div>
  </section>

  <div class="rule max-w-6xl mx-auto mt-14"></div>

  <!-- ═══ ZERO TO RUNNING ═══ -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Getting started">
    <div class="mb-8 max-w-xl" data-reveal>
      <span class="deck-label">From zero to running</span>
      <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Three steps to a running server.
      </h2>
    </div>

    <div class="deck-panel overflow-hidden grid grid-cols-1 md:grid-cols-3 gap-px bg-border/40" data-reveal-stagger>
      {steps.map((s) => (
        <div class="bg-card p-4 sm:p-5 flex flex-col">
          <span class="font-mono text-micro text-primary tabular-nums">{s.n}</span>
          <h3 class="mt-2 font-display text-data font-semibold text-foreground">{s.title}</h3>
          <p class="mt-1.5 text-mini text-muted-foreground leading-relaxed flex-1">{s.body}</p>
          <div class="mt-3 pt-3 border-t border-border/40 font-mono text-micro text-muted-foreground/70 truncate">{s.code}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="rule max-w-6xl mx-auto"></div>

  <!-- ═══ WHY CONTAINERD ═══ -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Performance">
    <div class="mb-8 max-w-xl" data-reveal>
      <span class="deck-label">Why containerd</span>
      <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Game nodes talk to containerd directly.
      </h2>
      <p class="mt-3 text-mini sm:text-data text-muted-foreground leading-relaxed">
        Game nodes talk directly to containerd, the runtime behind Kubernetes, instead of layering through Docker. The panel still ships as Docker Compose; the workload runs natively on nodes.
      </p>
    </div>

    <div class="deck-panel overflow-hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-border/40" data-reveal-stagger>
      {bigStats.map((s) => (
        <div class="bg-card p-4 flex flex-col">
          <div class="flex items-center gap-1.5">
            {s.live && <span class="led-wrap"><span class="led-pulse bg-success"></span><span class="led bg-success"></span></span>}
            <span class="type-overline">{s.label}</span>
          </div>
          <div class="mt-2 font-mono text-xl font-semibold tracking-tight text-foreground tabular-nums">{s.value}</div>
          {s.meter !== null && (
            <span class="meter mt-2 w-full"><span class="meter-fill bg-primary/60" style={`width:${s.meter}%`}></span></span>
          )}
          <p class="mt-2 text-micro text-muted-foreground leading-relaxed">{s.hint}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="rule max-w-6xl mx-auto"></div>

  <!-- ═══ FLEET ═══ -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Fleet management">
    <div class="mb-8 max-w-xl" data-reveal>
      <span class="deck-label">Fleet overview</span>
      <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Nodes, servers, and health in one view.
      </h2>
      <p class="mt-3 text-mini sm:text-data text-muted-foreground leading-relaxed">
        Nodes, servers, and health in one dashboard, with live status, metrics, and alerts. The table below is an illustration; real data streams from your nodes.
      </p>
    </div>

    <div data-reveal>
      <FleetDeck />
    </div>
  </section>

  <div class="rule max-w-6xl mx-auto"></div>

  <!-- ═══ ARCHITECTURE ═══ -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Architecture">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-6" data-reveal>
        <span class="deck-label">Stack</span>
        <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
          containerd on nodes, Docker for the panel.
        </h2>
        <p class="mt-3 text-mini sm:text-data text-muted-foreground leading-relaxed max-w-md">
          Game nodes talk directly to containerd, the runtime behind Kubernetes. The panel ships as Docker Compose with PostgreSQL and Redis. No Docker daemon runs on game nodes.
        </p>
      </div>

      <div class="lg:col-span-6 w-full" data-reveal>
        <div class="deck-panel overflow-hidden">
          {archLayers.map((layer, i) => (
            <>
              {i > 0 && <div class="rule"></div>}
              <div class:list={[
                "flex items-center justify-between gap-3 px-3 py-2.5",
                layer.tone === "hl" && "bg-primary/[0.05]",
              ]}>
                <div class="min-w-0">
                  <div class:list={[
                    "font-display text-data font-semibold tracking-tight",
                    layer.tone === "hl" ? "text-primary" : "text-foreground",
                    layer.tone === "dim" && "text-foreground/70",
                  ]}>{layer.name}</div>
                  <div class="mt-0.5 text-micro text-muted-foreground truncate">{layer.detail}</div>
                </div>
                {layer.tone === "hl" && <span class="led bg-primary shrink-0"></span>}
              </div>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="rule max-w-6xl mx-auto"></div>

  <!-- ═══ CAPABILITIES ═══ -->
  <section class="max-w-6xl mx-auto px-4 py-14 sm:py-16" aria-label="Features">
    <div class="mb-8 max-w-lg" data-reveal>
      <span class="deck-label">Built for hosts</span>
      <h2 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        What the panel ships with.
      </h2>
    </div>

    <div class="deck-panel overflow-hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border/40" data-reveal-stagger>
      {features.map((f) => (
        <div class="bg-card p-4 flex items-start gap-3">
          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-sm border border-border/70 bg-surface-1 text-muted-foreground">
            <Fragment set:html={f.icon} />
          </span>
          <div class="min-w-0">
