---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import githubStats from "../data/github-stats.json";
import { formatCount } from "../lib/github-stats.mjs";
import heroImg from "../assets/screenshots/user/dashboard.png";
import shot1 from "../assets/screenshots/user/dashboard.png";
import shot2 from "../assets/screenshots/user/profile.png";
import shot3 from "../assets/screenshots/user/server-test.png";
import shot4 from "../assets/screenshots/user/servers.png";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";
const INSTALL_CMD = "curl -fsSL https://raw.githubusercontent.com/catalystctl/catalyst/main/install.sh | bash";

const previewShots = [
  { img: shot1, alt: "Catalyst dashboard with server fleet overview" },
  { img: shot2, alt: "Catalyst user profile and account settings" },
  { img: shot3, alt: "Catalyst live server console and test output" },
  { img: shot4, alt: "Catalyst servers list with status and resources" },
];

const features = [
  {
    title: "Create Server",
    description: "Deploy from a template in seconds with automatic environment provisioning.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>`,
  },
  {
    title: "Real-Time Console",
    description: "Live log streaming via WebSocket with zero-latency bidirectional I/O.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z" /></svg>`,
  },
  {
    title: "Enterprise Security",
    description: "RBAC with 20+ permissions, API keys, audit logging, and TLS by default.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  },
  {
    title: "Register Node",
    description: "Add bare-metal or VM infrastructure with a lightweight Rust agent.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>`,
  },
  {
    title: "Plugin System",
    description: "Extend the API with custom routes, hooks, and scheduled background tasks.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>`,
  },
  {
    title: "View Alerts",
    description: "Customizable alerts and monitoring dashboards across every node in your fleet.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>`,
  },
];

const comparison = [
  { feature: "Runtime", catalyst: "containerd (native)", pterodactyl: "Docker (layered)" },
  { feature: "Backend", catalyst: "Rust + TypeScript", pterodactyl: "PHP" },
  { feature: "WebSocket latency", catalyst: "<10ms", pterodactyl: "~100ms" },
  { feature: "API endpoints", catalyst: "60+ REST", pterodactyl: "~40" },
  { feature: "Plugin system", catalyst: "Native hooks", pterodactyl: "None" },
  { feature: "RBAC permissions", catalyst: "20+ granular", pterodactyl: "Basic" },
  { feature: "Install", catalyst: "Single script", pterodactyl: "Manual + Wings" },
];

const metrics = [
  { value: "60+", label: "REST endpoints" },
  { value: "<10ms", label: "Console latency" },
  { value: "60s", label: "Typical install" },
  { value: "GPLv3", label: "Open source" },
];

const gh = githubStats;
const ciState = gh.ci?.state ?? "unknown";
const ciLabel = gh.ci?.label ?? "Unknown";

// Build-time seed; the client refreshes these from /api/github-stats.json hourly.
const repoStats = [
  {
    key: "commits",
    label: "Commits",
    value: formatCount(gh.commits) ?? "?",
    href: `${gh.repoUrl}/commits/main`,
  },
  {
    key: "releases",
    label: "Releases",
    value: formatCount(gh.releases) ?? "?",
    href: `${gh.repoUrl}/releases`,
  },
  {
    key: "ci",
    label: "CI Status",
    value: ciLabel,
    state: ciState,
    href: gh.ci?.url ?? `${gh.repoUrl}/actions`,
  },
  {
    key: "contributors",
    label: "Contributors",
    value: formatCount(gh.contributors) ?? "?",
    href: `${gh.repoUrl}/graphs/contributors`,
  },
];

const faqs = [
  {
    q: "Is Catalyst a Pterodactyl replacement?",
    a: "Yes. Catalyst covers the same core use cases (game server management, node orchestration, user panels, admin dashboards) with a faster Rust backend, containerd runtime, and a plugin system Pterodactyl lacks.",
  },
  {
    q: "How is Catalyst different from Pterodactyl?",
    a: "Catalyst uses Rust instead of PHP, containerd instead of Docker, and ships 60+ REST endpoints. You also get a native plugin system, sub-10ms WebSocket console latency, and RBAC with 20+ granular permissions.",
  },
  {
    q: "Can I migrate from Pterodactyl to Catalyst?",
    a: "Yes. Catalyst supports importing servers, eggs, and user data from Pterodactyl. The migration guide walks through each step. The containerd runtime works with most Pterodactyl Docker images.",
  },
  {
    q: "Is Catalyst free and open source?",
    a: "Yes. Catalyst is GPLv3. Backend, frontend, node agent, and docs are on GitHub. No paid tiers or feature gates.",
  },
  {
    q: "What games does Catalyst support?",
    a: "Any game that runs in a Linux container: Minecraft (Java and Bedrock), Counter-Strike 2, Rust, ARK, Terraria, Team Fortress 2, and hundreds more through custom egg definitions.",
  },
  {
    q: "What are the system requirements?",
    a: "Any Linux server with Docker and Docker Compose. The panel needs about one CPU core and 512MB RAM for small fleets. Nodes need containerd and the Catalyst agent.",
  },
];
---

<Layout title="Home" description="Catalyst is the modern Pterodactyl replacement. A fast, secure game server management platform built with Rust, TypeScript, and containerd. Deploy game servers in 60 seconds.">

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg> Copied';
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = original; btn.classList.remove('copied'); }, 2000);
      });
    });
  </script>

  <!-- HERO: asymmetric split, conversion-first -->
  <section class="relative overflow-hidden" aria-label="Catalyst overview">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -top-32 -left-24 h-[28rem] w-[28rem] rounded-full bg-primary/[0.09] blur-3xl"></div>
      <div class="absolute top-1/3 right-0 h-72 w-72 rounded-full bg-primary/[0.04] blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,hsl(25_55%_58%/0.08),transparent_55%)]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 pt-10 pb-8 sm:pt-14 sm:pb-12 lg:pt-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <div class="lg:col-span-5" data-reveal>
          <div class="inline-flex items-center gap-2 rounded-full border border-success/20 bg-success/[0.08] px-3 py-1 text-xs font-medium text-success mb-5">
            <span class="status-dot status-dot-success"></span>
            Open source · early testing
          </div>

          <h1 class="font-display font-bold text-foreground tracking-tight text-balance leading-[1.08]" style="font-size: clamp(2.15rem, 5.2vw, 3.65rem);">
            Game servers that feel instant.
            <span class="text-primary"> Built in Rust.</span>
          </h1>

          <p class="mt-4 max-w-[36ch] text-base sm:text-lg text-zinc-400 leading-relaxed text-pretty">
            Drop-in Pterodactyl alternative with sub-10ms console streaming and a one-line install.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="#install" class="cta-primary inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:bg-primary-600 active:scale-[0.98] min-h-11 shadow-[0_0_0_1px_hsl(25_55%_50%/0.3),0_8px_28px_-8px_hsl(25_55%_58%/0.45)]">
              Install in 60s
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" /></svg>
            </a>
            <a href={B + "screenshots/"} class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 bg-surface-1/60 px-5 py-3 text-sm font-medium text-zinc-200 transition-all duration-200 hover:bg-surface-2 hover:border-zinc-600 active:scale-[0.98] min-h-11">
              See the panel
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 relative" data-reveal>
          <div class="relative rounded-xl border border-zinc-800/80 bg-[#0c0c0e] overflow-hidden shadow-2xl shadow-black/50 ring-1 ring-primary/10">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-zinc-800/60 bg-[#111113]">
              <div class="w-2.5 h-2.5 rounded-full bg-[#ec6b5e]"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#f3bf4f]"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#61c253]"></div>
              <div class="ml-3 flex-1 max-w-xs">
                <div class="h-5 rounded bg-zinc-800/80 flex items-center px-2.5">
                  <span class="text-[10px] text-zinc-600 font-mono">localhost/dashboard</span>
                </div>
              </div>
            </div>
            <Image
              src={heroImg}
              alt="Catalyst game server management dashboard showing server list and real-time console"
              class="w-full object-cover object-top max-h-[220px] sm:max-h-[340px] lg:max-h-[420px]"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="absolute -bottom-6 left-8 right-8 h-16 bg-primary/[0.12] blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GITHUB STATS strip (layout family: live OSS activity) -->
  <section class="max-w-6xl mx-auto px-4 pt-6 pb-2" aria-label="Repository activity" data-reveal>
    <div id="github-stats" class="rounded-xl border border-zinc-800/60 bg-surface-1/80 backdrop-blur-sm px-4 sm:px-6 py-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {repoStats.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col items-center sm:items-start transition-colors hover:opacity-80"
            data-stat-key={s.key}
          >
            <div class="flex items-center gap-2 mb-1">
              {s.key === "ci" && (
                <span
                  class:list={[
                    "inline-block w-2 h-2 rounded-full",
                    s.state === "passing" ? "bg-success" : s.state === "failing" ? "bg-danger" : "bg-zinc-600",
                  ]}
                  data-ci-dot
                  aria-hidden="true"
                />
              )}
              <span class="text-xs text-zinc-500">{s.label}</span>
            </div>
            <div
              class="font-display text-xl sm:text-2xl font-bold text-foreground tracking-tight tabular-nums"
              data-stat-value={s.key}
            >
              {s.value}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- METRICS strip (layout family: tight horizontal stats) -->
  <section class="max-w-6xl mx-auto px-4 pt-6 pb-4" aria-label="Key metrics" data-reveal>
    <div class="rounded-xl border border-zinc-800/60 bg-surface-1/80 backdrop-blur-sm px-4 sm:px-6 py-5 grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-4">
      {metrics.map((m) => (
        <div class="text-center sm:text-left sm:border-r sm:border-zinc-800/60 sm:last:border-0 sm:pr-4">
          <div class="font-display text-2xl sm:text-3xl font-bold text-foreground tracking-tight tabular-nums">{m.value}</div>
          <div class="mt-1 text-xs text-zinc-500">{m.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- INSTALL: conversion block (layout family: terminal-first) -->
  <section id="install" class="max-w-6xl mx-auto px-4 py-20 scroll-mt-20" aria-label="Quick start">
    <div class="relative rounded-2xl border border-zinc-800/70 overflow-hidden" data-reveal>
      <div class="absolute inset-0 bg-gradient-to-br from-[#1a1510]/70 via-surface-1 to-surface-0 pointer-events-none"></div>
      <div class="absolute -top-20 -right-16 h-64 w-64 rounded-full bg-primary/[0.07] blur-3xl pointer-events-none"></div>

      <div class="relative grid grid-cols-1 lg:grid-cols-5 gap-0">
        <div class="lg:col-span-2 p-6 sm:p-8 lg:p-10 flex flex-col justify-center border-b lg:border-b-0 lg:border-r border-zinc-800/60">
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
            One command. Sixty seconds.
          </h2>
          <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-sm">
            No Wings daemon. No dependency maze. Clone, set PUBLIC_URL, bring the stack up.
          </p>
          <ul class="mt-6 space-y-2.5">
            {["Docker Compose included", "Auto-generated secrets", "TLS-ready defaults", "Works on bare Linux"].map((t) => (
              <li class="flex items-center gap-2.5 text-sm text-zinc-300">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-primary/15 text-primary">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </span>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-3 p-4 sm:p-6 lg:p-8 flex flex-col justify-center">
          <div class="terminal overflow-x-auto shadow-elevated-dark">
            <div class="terminal-header">
              <div class="terminal-dot" style="background:#ec6b5e;"></div>
              <div class="terminal-dot" style="background:#f3bf4f;"></div>
              <div class="terminal-dot" style="background:#61c253;"></div>
              <span class="text-[11px] text-zinc-600 font-mono ml-2">install.sh</span>
              <button class="copy-btn" data-copy={INSTALL_CMD} aria-label="Copy install command">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5"/></svg>
                Copy
              </button>
            </div>
            <div class="terminal-body whitespace-pre-wrap sm:whitespace-normal text-[13px] sm:text-sm">
              <div><span class="prompt">$</span> <span class="cmd">curl -fsSL https://raw.githubusercontent.com/</span></div>
              <div class="pl-[1.1rem]"><span class="cmd">catalystctl/catalyst/main/install.sh | bash</span></div>
              <div class="mt-1.5"><span class="prompt">$</span> <span class="cmd">cd catalyst-docker && nano .env</span></div>
              <div class="comment"># Set PUBLIC_URL at minimum</div>
              <div class="mt-1.5"><span class="prompt">$</span> <span class="cmd">docker compose up -d</span></div>
              <div class="mt-2.5"><span class="success">✓</span> <span class="cmd">Panel live at</span> <span class="url">http://localhost</span></div>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a href={B + "docs/"} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-400 transition-colors py-1">
              Read the docs
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <span class="text-zinc-700">·</span>
            <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-300 transition-colors py-1">
              Source on GitHub
            </a>
            <span class="text-zinc-700">·</span>
            <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-300 transition-colors py-1">
              Discord
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON (layout family: highlighted data table) -->
  <section class="max-w-6xl mx-auto px-4 py-16 sm:py-20" aria-label="Comparison with Pterodactyl">
    <div class="mb-8 max-w-xl" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Why hosts switch from Pterodactyl.
      </h2>
      <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed">
        Same job, modern stack. Rust where it hurts, containerd where Docker layers drag you down.
      </p>
    </div>

    <div class="sm:hidden space-y-3" data-reveal>
      {comparison.map((row) => (
        <div class="rounded-xl border border-zinc-800/60 bg-surface-1 p-4">
          <div class="text-sm font-medium text-zinc-300 mb-3">{row.feature}</div>
          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-lg bg-primary/[0.08] border border-primary/20 p-3">
              <div class="text-[10px] text-primary font-semibold mb-1">Catalyst</div>
              <div class="text-sm font-medium text-foreground">{row.catalyst}</div>
            </div>
            <div class="rounded-lg bg-zinc-900/40 p-3">
              <div class="text-[10px] text-zinc-600 font-semibold mb-1">Pterodactyl</div>
              <div class="text-sm text-zinc-500">{row.pterodactyl}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="hidden sm:block rounded-xl border border-zinc-800/60 overflow-hidden" data-reveal>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-surface-1">
            <th class="py-3.5 px-5 text-sm font-medium text-zinc-500 w-[34%]">Feature</th>
            <th class="py-3.5 px-5 text-sm font-semibold text-primary w-[33%] bg-primary/[0.06]">Catalyst</th>
            <th class="py-3.5 px-5 text-sm font-medium text-zinc-500 w-[33%]">Pterodactyl</th>
          </tr>
        </thead>
        <tbody>
          {comparison.map((row) => (
            <tr class="border-t border-zinc-800/40 hover:bg-surface-1/40 transition-colors">
              <td class="py-3.5 px-5 text-sm text-zinc-400">{row.feature}</td>
              <td class="py-3.5 px-5 text-sm font-medium text-foreground bg-primary/[0.04]">{row.catalyst}</td>
              <td class="py-3.5 px-5 text-sm text-zinc-600">{row.pterodactyl}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-6 flex flex-wrap gap-4" data-reveal>
      <a href={B + "pterodactyl-alternative/"} class="text-sm font-medium text-primary hover:text-primary-400 transition-colors">
        Open comparison
      </a>
      <a href={B + "migrate-from-pterodactyl/"} class="text-sm font-medium text-zinc-500 hover:text-zinc-300 transition-colors">
        Open migration guide
      </a>
    </div>
  </section>

  <!-- FEATURES bento (layout family: asymmetric feature mosaic) -->
  <section class="max-w-6xl mx-auto px-4 py-16 sm:py-20" aria-label="Features">
    <div class="mb-10 max-w-lg" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Everything you need to run a fleet.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3" data-reveal-stagger>
      <div class="md:col-span-2 md:row-span-2 group relative rounded-xl border border-primary/25 overflow-hidden p-6 sm:p-8 flex flex-col justify-between min-h-[280px] transition-all duration-300 hover:border-primary/40">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/[0.14] via-surface-1 to-surface-0 pointer-events-none"></div>
        <div class="absolute bottom-0 right-0 w-48 h-48 bg-primary/[0.08] rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative">
          <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary/20 text-primary">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z" /></svg>
          </div>
          <h3 class="mt-5 font-display text-2xl font-semibold text-foreground text-balance">Real-time console, zero latency theatre.</h3>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed max-w-md">
            Live logs over a native Rust WebSocket layer. Sub-10ms round-trip, bidirectional I/O, no Node hop in the middle.
          </p>
        </div>
        <div class="relative mt-8 font-mono text-[11px] text-zinc-600 space-y-1 hidden sm:block">
          <div><span class="text-primary">ws</span> · console stream active</div>
          <div class="text-zinc-700">rtt 6.2ms · frames 120/s</div>
        </div>
      </div>

      {features.filter((f) => f.title !== "Real-Time Console").map((f, i) => (
        <div class:list={[
          "group rounded-xl border border-zinc-800/60 p-5 transition-all duration-200 hover:border-zinc-700 hover:bg-surface-2",
          i === 0 ? "bg-surface-2/80" : i === 2 ? "bg-gradient-to-b from-surface-1 to-[#12100e]" : "bg-surface-1",
        ]}>
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-800/80 text-zinc-400 transition-colors group-hover:text-primary group-hover:bg-primary/15">
            <Fragment set:html={f.icon} />
          </div>
          <h3 class="mt-4 font-semibold text-foreground text-[15px]">{f.title}</h3>
          <p class="mt-1.5 text-sm text-zinc-500 leading-relaxed">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SCREENSHOTS (layout family: horizontal scroll-snap) -->
  <section class="py-16 sm:py-20 overflow-hidden" aria-label="Screenshots preview">
    <div class="max-w-6xl mx-auto px-4 mb-8 flex flex-wrap items-end justify-between gap-4" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">
        See it in action.
      </h2>
      <a href={B + "screenshots/"} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-primary-400 transition-colors py-2">
        All screenshots
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>

    <div class="max-w-6xl mx-auto px-4" data-reveal>
      <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 no-scrollbar">
        {previewShots.map((shot) => (
          <a
            href={B + "screenshots/"}
            class="group snap-start shrink-0 w-[85%] sm:w-[55%] lg:w-[42%] block rounded-xl border border-zinc-800/60 overflow-hidden bg-[#0c0c0e] transition-all duration-300 hover:border-primary/30 hover:shadow-[0_0_40px_-12px_hsl(25_55%_58%/0.25)]"
          >
            <div class="flex items-center gap-1.5 px-3 py-2 bg-[#111113] border-b border-zinc-800/60">
              <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
              <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
              <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
            </div>
            <div class="aspect-video overflow-hidden">
              <Image
                src={shot.img}
                alt={shot.alt}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PATHS (layout family: three destination tiles, different from feature cards) -->
  <section class="max-w-6xl mx-auto px-4 py-12" aria-label="Related pages">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px rounded-xl border border-zinc-800/60 overflow-hidden bg-zinc-800/60" data-reveal-stagger>
      <a href={B + "pterodactyl-alternative/#comparison"} class="group bg-surface-1 p-6 sm:p-7 transition-colors hover:bg-surface-2">
        <h3 class="font-semibold text-foreground text-[15px] group-hover:text-primary transition-colors">Catalyst vs Pterodactyl</h3>
        <p class="mt-2 text-sm text-zinc-500 leading-relaxed">Architecture, performance, and ops compared side by side.</p>
        <span class="mt-4 inline-flex text-xs font-medium text-zinc-600 group-hover:text-primary transition-colors">Open comparison</span>
      </a>
      <a href={B + "migrate-from-pterodactyl/"} class="group bg-surface-1 p-6 sm:p-7 transition-colors hover:bg-surface-2">
        <h3 class="font-semibold text-foreground text-[15px] group-hover:text-primary transition-colors">Migrate from Pterodactyl</h3>
        <p class="mt-2 text-sm text-zinc-500 leading-relaxed">Move servers, eggs, and users without starting from scratch.</p>
        <span class="mt-4 inline-flex text-xs font-medium text-zinc-600 group-hover:text-primary transition-colors">Open migration guide</span>
      </a>
      <a href={B + "docs/"} class="group bg-surface-1 p-6 sm:p-7 transition-colors hover:bg-surface-2">
        <h3 class="font-semibold text-foreground text-[15px] group-hover:text-primary transition-colors">Documentation</h3>
        <p class="mt-2 text-sm text-zinc-500 leading-relaxed">Install, configure nodes, and wire up the API in one place.</p>
        <span class="mt-4 inline-flex text-xs font-medium text-zinc-600 group-hover:text-primary transition-colors">Read the docs</span>
      </a>
    </div>
  </section>

  <!-- FAQ (layout family: definition list, no card grid) -->
  <section class="max-w-6xl mx-auto px-4 py-16 sm:py-20" aria-label="Frequently asked questions">
    <div class="mb-10 max-w-lg" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
        Common questions, plain answers.
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-0" data-reveal>
      {faqs.map((faq) => (
        <details class="faq-item group border-b border-zinc-800/50 py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left">
            <h3 class="font-semibold text-foreground text-[15px] leading-snug pr-2">{faq.q}</h3>
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-zinc-800 text-zinc-500 transition-colors group-open:border-primary/40 group-open:text-primary group-open:bg-primary/10">
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </span>
          </summary>
          <p class="mt-3 text-sm text-zinc-500 leading-relaxed max-w-prose pr-10">{faq.a}</p>
        </details>
      ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a,
        },
      })),
    })} />
  </section>

  <!-- FINAL CTA -->
  <section class="max-w-6xl mx-auto px-4 py-16 sm:py-20" aria-label="Call to action">
    <div class="relative rounded-2xl border border-primary/20 overflow-hidden p-8 sm:p-12 lg:p-14" data-reveal>
      <div class="absolute inset-0 bg-gradient-to-br from-[#1a1510] via-surface-1 to-surface-0 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-80 h-80 bg-primary/[0.12] rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-56 h-56 bg-primary/[0.05] rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-xl">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-foreground tracking-tight text-balance">
          Spin up a panel tonight.
        </h2>
        <p class="mt-3 text-base text-zinc-400 max-w-md">
          Free, GPLv3, no feature gates. Copy the install command and be live before the coffee cools.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#install" class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:bg-primary-600 active:scale-[0.98] min-h-11 shadow-[0_0_0_1px_hsl(25_55%_50%/0.3),0_8px_28px_-8px_hsl(25_55%_58%/0.45)]">
            Install in 60s
          </a>
          <a href={B + "docs/"} class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all duration-200 hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98] min-h-11">
            Read the docs
          </a>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all duration-200 hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98] min-h-11">
            Join Discord
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="h-8"></div>
</Layout>
