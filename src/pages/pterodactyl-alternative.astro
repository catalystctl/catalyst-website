  </section>

  <!-- AEO structured data: FAQPage + ItemList for comparison -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": lookFor.map((item) => ({
      "@type": "Question",
      "name": item.title,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.body,
      },
    })),
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Pterodactyl alternative comparison",
    "itemListElement": comparisons.flatMap((section) =>
      section.rows.map((row, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": `${section.category}: ${row.feature}`,
        "description": `Catalyst: ${row.catalyst} vs Pterodactyl: ${row.pterodactyl}`,
      }))
    ),
  })} />

  <div class="h-8"></div>
</Layout>
