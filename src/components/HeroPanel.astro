---
/**
 * HeroPanel: faithful recreation of the current Catalyst panel dashboard.
 * Icon rail + deck panels + deck-label section markers, matching the live
 * product chrome (demo.catalystctl.com/dashboard).
 * Animates resource bars and activity timestamps; subtle parallax tilt.
 * All motion is disabled under prefers-reduced-motion.
 */
const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";

const rail = [
  {
    key: "dashboard",
    label: "Dashboard",
    active: true,
    icon: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>`,
  },
  {
    key: "servers",
    label: "Servers",
    icon: `<rect x="2" y="4" width="20" height="7" rx="2"/><rect x="2" y="13" width="20" height="7" rx="2"/><path d="M6 7.5h.01M6 16.5h.01"/>`,
  },
  {
    key: "nodes",
    label: "Nodes",
    icon: `<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 12h16M12 4v16"/>`,
  },
  {
    key: "users",
    label: "Users",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    key: "alerts",
    label: "Alerts",
    icon: `<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/>`,
  },
  {
    key: "activity",
    label: "Activity",
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`,
  },
  {
    key: "settings",
    label: "Settings",
    icon: `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.09A1.65 1.65 0 0 0 10 3.09V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>`,
  },
];

// Fleet vitals: label, mono value, optional bar width, right-hand hint.
const vitals = [
  { label: "Servers", value: "2/4", bar: null, hint: "2 running", id: null },
  { label: "Nodes", value: "1/2", bar: null, hint: "1 connected", id: null },
  { label: "CPU", value: "18%", bar: 18, hint: "", id: "cpu" },
  { label: "Memory", value: "31%", bar: 31, hint: "", id: "mem" },
  { label: "Network", value: "42 MB/s", bar: 42, hint: "", id: "net" },
  { label: "Alerts", value: "1", bar: null, hint: "1 unacknowledged", id: null },
];

const attention = [
  { text: "1 node offline", tag: "Nodes", tone: "warn" },
  { text: "1 open alert", tag: "Alerts", tone: "warn" },
];

const activity = [
  { title: "demo-paper-01 started", detail: "server is now running", tone: "success", ago: 4 },
  { title: "Backup completed", detail: "demo-forge-01 nightly backup", tone: "success", ago: 12 },
  { title: "demo-tsa-1 went offline", detail: "Agent heartbeat missed", tone: "info", ago: 26 },
  { title: "High memory usage", detail: "demo-paper-01 above 80%", tone: "warning", ago: 38 },
  { title: "Demo admin signed in", detail: "read-only demo session", tone: "idle", ago: 52 },
];
---

<div class="hp-scene" id="hp-scene">
  <div class="hp-panel" id="hp-panel" role="img" aria-label="Animated preview of the Catalyst game server management dashboard">
    <!-- Icon rail -->
    <aside class="hp-rail" aria-hidden="true">
      <span class="hp-rail-brand">
        <img src={B + "logo-64.webp"} alt="" width="20" height="20" />
      </span>

      <nav class="hp-rail-nav">
        {rail.map((item) => (
          <span class:list={["hp-rail-item", item.active && "hp-rail-active"]} title={item.label}>
            {item.active && <span class="hp-rail-bar"></span>}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          </span>
        ))}
      </nav>

      <div class="hp-rail-foot">
        <span class="hp-rail-item" title="Theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </span>
        <span class="hp-avatar">DE</span>
        <span class="hp-rail-item" title="Sign out">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
        </span>
      </div>
    </aside>

    <!-- Main -->
    <div class="hp-main">
      <header class="hp-topbar">
        <span class="hp-crumb">Dashboard</span>
        <div class="hp-topbar-right">
          <span class="hp-count">1/2</span>
          <span class="hp-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
            Search…
            <kbd>Ctrl K</kbd>
          </span>
        </div>
      </header>

      <div class="hp-content">
        <!-- Page header -->
        <header class="hp-pagehead">
          <div class="hp-pagehead-main">
            <span class="deck-label">Overview</span>
            <h1 class="hp-title">Dashboard</h1>
            <p class="hp-sub">Infrastructure overview for Demo Admin.</p>
          </div>
          <span class="hp-alertpill"><span class="hp-dot-warn"></span> 1 unacknowledged alert</span>
        </header>

        <!-- Fleet vitals -->
        <section class="hp-card hp-vitals">
          <div class="hp-cardhead">
            <span class="deck-label">Fleet vitals</span>
            <span class="hp-viewall">View all <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
          <div class="hp-rows">
            {vitals.map((v) => (
              <div class="hp-row">
                <span class="hp-row-label">{v.label}</span>
                <span class="hp-row-value" id={v.id ? `hp-${v.id}-val` : undefined}>{v.value}</span>
                {v.bar !== null
                  ? <span class="hp-bar"><span class="hp-bar-fill" id={v.id ? `hp-${v.id}` : undefined} style={`width:${v.bar}%`}></span></span>
                  : <span class="hp-bar hp-bar-empty"></span>}
                <span class="hp-row-hint">{v.hint}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Two-column row -->
        <div class="hp-cols">
          <section class="hp-card">
            <div class="hp-cardhead">
              <span class="deck-label deck-label--alarm">Needs attention</span>
            </div>
            <div class="hp-rows">
              {attention.map((a) => (
                <div class="hp-attn">
                  <span class:list={["hp-dot", `hp-dot-${a.tone}`]}></span>
                  <span class="hp-attn-text">{a.text}</span>
                  <span class="hp-attn-tag">{a.tag}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="hp-card">
            <div class="hp-cardhead">
              <span class="deck-label">Recent activity</span>
              <span class="hp-viewall">View all <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </div>
            <ul class="hp-rows hp-feed" id="hp-feed">
              {activity.map((a) => (
                <li class="hp-feed-item">
                  <span class:list={["hp-dot", `hp-dot-${a.tone}`]}></span>
                  <span class="hp-feed-meta">
                    <span class="hp-feed-title">{a.title}</span>
                    <span class="hp-feed-detail">{a.detail}</span>
                  </span>
                  <span class="hp-feed-ago" data-ago={a.ago}>{a.ago}s ago</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>

  <!-- Floor glow -->
  <div class="hp-floor" aria-hidden="true"></div>
</div>

<style>
  .hp-scene {
    perspective: 1600px;
  }

  .hp-panel {
    display: grid;
    grid-template-columns: 56px 1fr;
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid hsl(var(--border) / 0.75);
    background: hsl(var(--card));
    overflow: hidden;
    text-align: left;
    box-shadow:
      var(--shadow-panel),
      0 24px 60px -24px rgb(0 0 0 / 0.7),
      0 0 80px -36px hsl(var(--signal) / 0.22);
    transition: transform 0.25s ease-out;
    will-change: transform;
    min-height: 380px;
  }
  @media (max-width: 640px) {
    .hp-panel { grid-template-columns: 1fr; }
    .hp-rail { display: none !important; }
  }

  /* ── Icon rail ── */
  .hp-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-right: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--surface-1) / 0.4);
    padding: 0.5rem 0;
  }
  .hp-rail-brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.5rem;
  }
  .hp-rail-brand img { width: 20px; height: 20px; border-radius: var(--radius); }
  .hp-rail-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    min-height: 0;
  }
  .hp-rail-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    color: hsl(var(--muted-foreground));
  }
  .hp-rail-item svg { width: 18px; height: 18px; }
  .hp-rail-active {
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--foreground));
  }
  .hp-rail-bar {
    position: absolute;
    left: 0.125rem;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 1rem;
    border-radius: 9999px;
    background: hsl(var(--primary));
  }
  .hp-rail-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .hp-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: hsl(var(--primary) / 0.16);
    border: 1px solid hsl(var(--primary) / 0.3);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: hsl(var(--primary-200));
    font-family: 'Oxanium Variable', system-ui, sans-serif;
  }

  /* ── Main ── */
  .hp-main { display: flex; flex-direction: column; min-width: 0; }
  .hp-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid hsl(var(--border) / 0.6);
  }
  .hp-crumb {
    font-size: 0.75rem;
    font-weight: 500;
    color: hsl(var(--foreground));
  }
  .hp-topbar-right { display: flex; align-items: center; gap: 0.5rem; }
  .hp-count {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--warning));
  }
  .hp-search {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.6rem;
    border-radius: var(--radius);
    border: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--surface-2) / 0.55);
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
  }
  .hp-search svg { width: 12px; height: 12px; }
  .hp-search kbd {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.625rem;
    padding: 1px 5px;
    border-radius: var(--radius);
    border: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--surface-2) / 0.8);
    color: hsl(var(--muted-foreground));
  }

  .hp-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.875rem;
    min-width: 0;
  }

  /* ── Page header ── */
  .hp-pagehead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }
  .hp-pagehead-main { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .hp-title {
    font-family: 'Oxanium Variable', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
    margin: 0.1rem 0 0;
  }
  .hp-sub {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
  }
  .hp-alertpill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding: 0 0.75rem;
    border-radius: var(--radius);
    border: 1px solid hsl(var(--warning) / 0.3);
    background: hsl(var(--warning) / 0.1);
    font-family: 'Oxanium Variable', system-ui, sans-serif;
    font-size: 0.75rem;
    color: hsl(var(--warning));
    white-space: nowrap;
  }
  .hp-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
  }
  .hp-dot-warn,
  .hp-dot-warning { background: hsl(var(--warning)); }
  .hp-dot-success { background: hsl(var(--success)); }
  .hp-dot-info { background: hsl(var(--info)); }
  .hp-dot-idle { background: hsl(var(--muted-foreground) / 0.5); }

  /* ── Deck panels ── */
  .hp-card {
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: var(--deck-radius);
    background: hsl(var(--card));
    overflow: hidden;
    min-width: 0;
  }
  .hp-cardhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid hsl(var(--border) / 0.5);
    background: hsl(var(--surface-1) / 0.4);
  }
  .deck-label {
    font-family: 'Oxanium Variable', Oxanium, system-ui, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: hsl(var(--muted-foreground));
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    line-height: 1.35;
  }
  .deck-label::before {
    content: "";
    flex: none;
    width: 0.375rem;
    height: 0.375rem;
    background: hsl(var(--signal));
  }
  .deck-label--alarm::before { background: hsl(var(--warning)); }
  .hp-viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6875rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }
  .hp-viewall svg { width: 11px; height: 11px; }

  .hp-rows > * + * {
    border-top: 1px solid hsl(var(--border) / 0.4);
  }

  /* ── Vitals rows ── */
  .hp-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.75rem;
  }
  .hp-row-label {
    width: 5rem;
    flex: none;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .hp-row-value {
    width: 5rem;
    flex: none;
    font-family: 'JetBrains Mono Variable', monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    font-weight: 600;
    color: hsl(var(--foreground));
  }
  .hp-bar {
    flex: 1;
    min-width: 2rem;
    height: 4px;
    border-radius: 9999px;
    background: hsl(var(--border) / 0.55);
    overflow: hidden;
  }
  .hp-bar-empty { background: transparent; }
  .hp-bar-fill {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: hsl(var(--primary));
    transition: width 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #hp-cpu { background: hsl(var(--primary)); }
  #hp-mem { background: hsl(var(--success)); }
  #hp-net { background: hsl(var(--info)); }
  .hp-row-hint {
    margin-left: auto;
    font-size: 0.6875rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }

  /* ── Needs attention ── */
  .hp-attn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
  }
  .hp-attn-text {
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--foreground));
  }
  .hp-attn-tag {
    margin-left: auto;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  /* ── Activity feed ── */
  .hp-feed { list-style: none; margin: 0; padding: 0; }
  .hp-feed-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
  }
  .hp-feed-item .hp-dot { margin-top: 0.35rem; }
  .hp-feed-meta { min-width: 0; flex: 1; line-height: 1.35; }
  .hp-feed-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hp-feed-detail {
    display: block;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.6875rem;
    color: hsl(var(--muted-foreground) / 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hp-feed-ago {
    font-size: 0.6875rem;
    color: hsl(var(--muted-foreground) / 0.7);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    margin-top: 0.1rem;
  }

  /* ── Layout rows ── */
  .hp-cols {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 0.75rem;
  }
  @media (max-width: 640px) {
    .hp-cols { grid-template-columns: 1fr; }
    .hp-feed-item:nth-child(n+4) { display: none !important; }
  }

  .hp-floor {
    height: 4rem;
    margin-top: -1.5rem;
    background: radial-gradient(ellipse 50% 100% at 50% 0%, hsl(var(--signal) / 0.12), transparent 70%);
    filter: blur(6px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-panel { transition: none; }
    .hp-bar-fill { transition: none; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Resource jitter (CPU / Memory / Network) ──
  if (!reduceMotion) {
    const el = (id: string) => document.getElementById(id);
    const cpu = el('hp-cpu'), cpuVal = el('hp-cpu-val');
    const mem = el('hp-mem'), memVal = el('hp-mem-val');
    const net = el('hp-net'), netVal = el('hp-net-val');
    setInterval(() => {
      const c = 8 + Math.round(Math.random() * 40);
      const m = 30 + Math.round(Math.random() * 14);
      const n = 18 + Math.round(Math.random() * 46);
      if (cpu) cpu.style.width = `${c}%`;
      if (cpuVal) cpuVal.textContent = `${c}%`;
      if (mem) mem.style.width = `${m}%`;
      if (memVal) memVal.textContent = `${m}%`;
      if (net) net.style.width = `${n}%`;
      if (netVal) netVal.textContent = `${n} MB/s`;
    }, 2800);
  }

  // ── Activity timestamps tick ──
  if (!reduceMotion) {
    const agos = document.querySelectorAll<HTMLElement>('.hp-feed-ago');
    setInterval(() => {
      agos.forEach((el) => {
        const next = parseInt(el.dataset.ago || '10', 10) + 5;
        el.dataset.ago = String(next);
        el.textContent = `${next}s ago`;
      });
    }, 5000);
  }

  // ── Parallax tilt ──
  const scene = document.getElementById('hp-scene');
  const panel = document.getElementById('hp-panel');
  if (scene && panel && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
    scene.addEventListener('pointermove', (e) => {
      const rect = scene.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      panel.style.transform = `rotateX(${(-y * 2).toFixed(2)}deg) rotateY(${(x * 2).toFixed(2)}deg)`;
    });
    scene.addEventListener('pointerleave', () => {
      panel.style.transform = '';
    });
  }
</script>
