---
import Layout from "../layouts/Layout.astro";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";

const links = [
  { href: B, label: "Home", blurb: "Product overview and install" },
  { href: "https://docs.catalystctl.com/", label: "Documentation", blurb: "Install, nodes, API, plugins", external: true },
  { href: B + "pterodactyl-alternative/", label: "Open comparison", blurb: "Catalyst vs Pterodactyl" },
  { href: "https://discord.gg/mybxhmru3y", label: "Discord", blurb: "Ask the community", external: true },
];
---

<Layout title="Page Not Found" description="The page you are looking for does not exist.">

  <section class="min-h-[70vh] flex items-center">
    <div class="max-w-6xl mx-auto px-4 py-16 sm:py-24 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-5">
          <p class="deck-label deck-label--hazard mb-3">404</p>
          <h1 class="font-display text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance">
            Page not found.
          </h1>
          <p class="mt-3 text-data text-muted-foreground leading-relaxed max-w-md text-pretty">
            The page does not exist or has moved. Pick a destination below, or go straight to the install command.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href={B + "#install"} class="btn btn-md btn-primary">Install panel</a>
            <a href={B} class="btn btn-md btn-outline">Go home</a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="deck-panel overflow-hidden grid grid-cols-1 sm:grid-cols-2 gap-px bg-border/40">
            {links.map((link) => (
              <a
                href={link.href}
                class="group bg-card p-4 transition-colors hover:bg-surface-1/40"
                {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <h2 class="font-display text-data font-semibold text-foreground group-hover:text-primary transition-colors">{link.label}</h2>
                <p class="mt-1 text-micro text-muted-foreground">{link.blurb}</p>
              </a>
            ))}
          </div>
          <p class="mt-4 text-micro text-muted-foreground/70">
            Think this is a bug?
            <a href={GITHUB_URL + "/issues"} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors underline underline-offset-2 decoration-border">
              Open an issue on GitHub
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
