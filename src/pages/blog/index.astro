---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const AUDIENCE_LABELS: Record<string, string> = {
  hobbyists: "Hobbyists",
  businesses: "Businesses",
  "hosting-providers": "Hosting Providers",
  enterprises: "Enterprises",
};

const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post !== featured);
---

<Layout
  title="Game Server Guides and Tutorials"
  description="Guides, comparisons, and tutorials for game server management with Catalyst. For hobbyists, hosting providers, and enterprises."
  breadcrumbItems={[{ name: "Blog" }]}
>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));
  </script>

  <div class="max-w-6xl mx-auto px-4 pt-10 sm:pt-14 pb-16">
    <div class="max-w-2xl mb-8" data-reveal>
      <span class="deck-label">Blog</span>
      <h1 class="mt-3 font-display text-[1.9rem] sm:text-[2.4rem] font-semibold text-foreground tracking-tight leading-[1.12] text-balance">
        Guides for game server operators.
      </h1>
      <p class="mt-3 text-data sm:text-base text-muted-foreground leading-relaxed max-w-lg text-pretty">
        Comparisons, migrations, and operations notes for hobby fleets and hosting providers.
      </p>
    </div>

    {featured && (
      <a
        href={`/blog/${featured.id}/`}
        class="group block deck-panel overflow-hidden mb-3 transition-colors hover:border-border"
        data-reveal
      >
        <div class="deck-toolbar justify-between">
          <span class="deck-label">Latest post</span>
          <time datetime={featured.data.pubDate.toISOString()} class="font-mono text-micro text-muted-foreground/70">
            {featured.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
        </div>
        <div class="p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-5">
          <div class="lg:col-span-9">
            {featured.data.audience?.length ? (
              <div class="flex flex-wrap items-center gap-1.5 mb-3">
                {featured.data.audience.map((a) => (
                  <span class="inline-flex items-center rounded-sm bg-primary/10 px-2 py-0.5 font-mono text-micro text-primary">
                    {AUDIENCE_LABELS[a] || a}
                  </span>
                ))}
              </div>
            ) : null}
            <h2 class="font-display text-xl sm:text-2xl font-semibold text-foreground group-hover:text-primary transition-colors leading-snug text-balance">
              {featured.data.title}
            </h2>
            <p class="mt-2 text-mini sm:text-data text-muted-foreground leading-relaxed max-w-2xl">
              {featured.data.description}
            </p>
          </div>
          <div class="lg:col-span-3 flex lg:items-end lg:justify-end">
            <span class="inline-flex items-center gap-1.5 text-micro text-muted-foreground/70 group-hover:text-primary transition-colors">
              Read post
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
            </span>
          </div>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="deck-panel overflow-hidden grid grid-cols-1 md:grid-cols-2 gap-px bg-border/40" data-reveal-stagger>
        {rest.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <a
              href={`/blog/${post.id}/`}
              class="group flex flex-col bg-card p-4 transition-colors hover:bg-surface-1/40"
            >
              <div class="flex flex-wrap items-center gap-2 mb-2">
                {post.data.audience?.map((a) => (
                  <span class="inline-flex items-center rounded-sm bg-primary/10 px-2 py-0.5 font-mono text-micro text-primary">
                    {AUDIENCE_LABELS[a] || a}
                  </span>
                ))}
                <time datetime={post.data.pubDate.toISOString()} class="font-mono text-micro text-muted-foreground/70">{formattedDate}</time>
              </div>
              <h2 class="font-display text-data font-semibold text-foreground group-hover:text-primary transition-colors leading-snug text-balance">
                {post.data.title}
              </h2>
              <p class="mt-1.5 text-mini text-muted-foreground leading-relaxed line-clamp-2 flex-1">
                {post.data.description}
              </p>
              <span class="mt-3 text-micro text-muted-foreground/70 group-hover:text-primary transition-colors">
                Read post
              </span>
            </a>
          );
        })}
      </div>
    )}

    {posts.length === 0 && (
      <div class="deck-panel p-10 text-center text-mini text-muted-foreground" data-reveal>
        <p>Guides, comparisons, and tutorials are on the way.</p>
      </div>
    )}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Catalyst Blog",
    "itemListElement": posts.map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://catalystctl.com/blog/${post.id}/`,
      "name": post.data.title,
    })),
  })} />
</Layout>
