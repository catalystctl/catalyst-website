            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" /></svg>
          </a>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all duration-200 hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98] min-h-11">
            Join Discord
          </a>
          <a href={B + "docs/"} class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-5 py-3 text-sm font-medium text-zinc-300 transition-all duration-200 hover:bg-surface-2 hover:text-zinc-100 active:scale-[0.98] min-h-11">
            Read the docs
          </a>
        </div>

        <div class="mt-6 inline-flex max-w-full items-center gap-3 rounded-lg border border-zinc-800/70 bg-surface-0/80 pl-4 pr-1.5 py-1.5 font-mono text-xs" data-reveal>
          <span class="text-primary select-none shrink-0">$</span>
          <code class="text-zinc-300 truncate">{INSTALL_CMD}</code>
          <button class="copy-btn shrink-0" data-copy={INSTALL_CMD} aria-label="Copy install command">
            Copy
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    // ── Scroll reveal ──
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));

    // ── Copy buttons ──
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg> Copied';
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = original; btn.classList.remove('copied'); }, 2000);
      });
    });

    // ── Spotlight cards: one delegated listener drives --mx/--my ──
    document.addEventListener('pointermove', (e) => {
      const card = (e.target as Element).closest?.('.spotlight-card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      card.style.setProperty('--my', `${e.clientY - rect.top}px`);
    }, { passive: true });

    // ── Install terminal: arm, then stagger lines when scrolled into view ──
    const term = document.getElementById('install-term');
    if (term && !reduceMotion) {
      const lines = term.querySelectorAll('.inst-line');
      term.classList.add('term-armed');
      const termObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          lines.forEach((line, i) => {
            (line as HTMLElement).style.transitionDelay = `${i * 320}ms`;
          });
          term.classList.add('term-play');
          termObserver.disconnect();
        });
      }, { threshold: 0.35 });
      termObserver.observe(term);
    }

    // ── Fleet ping jitter ──
    if (!reduceMotion) {
      const pings = document.querySelectorAll<HTMLElement>('.fleet-ping');
      setInterval(() => {
        pings.forEach((el) => {
          const base = parseInt(el.dataset.ping || '10', 10);
          const next = Math.max(1, base + Math.round((Math.random() - 0.5) * 6));
          el.textContent = `${next}ms`;
        });
      }, 2600);

      // ── "Built to feel fast": simulated live console latency ──
      const liveMs = document.querySelector('[data-live-ms]');
      if (liveMs) {
        setInterval(() => {
          liveMs.textContent = `${(3.2 + Math.random() * 6.2).toFixed(1)}ms`;
        }, 1400);
      }
    }
  </script>

  <style>
    /* Install terminal staged animation.
       Hidden state only applies once JS arms the terminal (.term-armed),
       so no-JS visitors and crawlers still see the full static output. */
    #install-term.term-armed .inst-line {
      opacity: 0;
      transform: translateY(5px);
    }
    #install-term.term-armed.term-play .inst-line {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    #install-term .inst-done {
      margin-top: 0.4rem;
    }
    @media (prefers-reduced-motion: reduce) {
      #install-term .inst-line { transition: none !important; }
    }
  </style>

  <div class="h-8"></div>
</Layout>
