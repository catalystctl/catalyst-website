---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const entries = await getCollection('docs');

interface DocGroup {
  label: string;
  items: { title: string; slug: string; description?: string; order: number }[];
}

const groups = new Map<string, DocGroup>();

for (const e of entries) {
  const parts = e.id.split('/');
  let group: DocGroup;

  if (parts.length >= 2) {
    const slug = parts.slice(0, -1).join('/');
    const label = parts.slice(0, -1).map(p => p.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())).join(' / ');
    if (!groups.has(slug)) groups.set(slug, { label, items: [] });
    group = groups.get(slug)!;
  } else {
    if (!groups.has('_root')) groups.set('_root', { label: 'Overview', items: [] });
    group = groups.get('_root')!;
  }

  group.items.push({ title: e.data.title, slug: e.id, description: e.data.description, order: e.data.order });
}

const GROUP_ORDER: Record<string, number> = {
  '_root': 0,
  'getting-started': 1,
  'admin-guide': 2,
  'user-guide': 3,
  'nodes': 4,
  'api-reference': 5,
  'automation': 6,
  'plugins': 7,
  'reference': 8,
  'development': 9,
};

const sidebar = Array.from(groups.entries())
  .sort((a, b) => (GROUP_ORDER[a[0]] ?? 99) - (GROUP_ORDER[b[0]] ?? 99))
  .map(([, g]) => ({ ...g, items: g.items.sort((a, b) => a.order - b.order) }));

const quickStarts = [
  { title: "Quickstart", slug: "getting-started/quickstart", blurb: "From zero to a live panel." },
  { title: "Installation", slug: "getting-started/installation", blurb: "One-line install and Docker Compose." },
  { title: "Admin guide", slug: "admin-guide/admin-guide", blurb: "Nodes, users, and fleet ops." },
].filter((q) => entries.some((e) => e.id === q.slug));
---

<Layout title="Catalyst Documentation — Install, Nodes, API & Plugins" description="Catalyst documentation: installation, configuration, nodes, plugins, and API reference.">

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => observer.observe(el));
  </script>

  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute top-0 right-0 h-72 w-72 glow-orb text-primary/[0.06]" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-4 pt-12 sm:pt-16 pb-20">
      <div class="max-w-2xl mb-10" data-reveal>
        <h1 class="font-display font-bold text-foreground tracking-tight text-balance" style="font-size: clamp(2.1rem, 5vw, 3.5rem);">
          Documentation
        </h1>
        <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed text-pretty">
          Install, configure nodes, wire the API, and ship plugins. Start with a quick path or browse by topic.
        </p>
      </div>

      {quickStarts.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-14" data-reveal-stagger>
          {quickStarts.map((q, i) => (
            <a
              href={`/docs/${q.slug}/`}
              class:list={[
                "group rounded-xl border p-5 transition-all duration-200 hover:border-primary/35",
                i === 0
                  ? "border-primary/25 bg-gradient-to-br from-primary/[0.1] to-surface-1"
                  : "border-zinc-800/60 bg-surface-1 hover:bg-surface-2",
              ]}
            >
              <h2 class="font-semibold text-foreground text-[15px] group-hover:text-primary transition-colors">{q.title}</h2>
              <p class="mt-1.5 text-sm text-zinc-500">{q.blurb}</p>
              <span class="mt-4 inline-flex text-xs font-medium text-zinc-600 group-hover:text-primary transition-colors">Open guide</span>
            </a>
          ))}
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 gap-y-12" data-reveal>
        {sidebar.map((group) => (
          <section>
            <h2 class="font-display text-sm font-semibold text-zinc-200 mb-3 pb-2 border-b border-zinc-800/60">
              {group.label}
            </h2>
            <ul class="space-y-0.5">
              {group.items.map((item) => (
                <li>
                  <a
                    href={`/docs/${item.slug}/`}
                    class="group flex items-start justify-between gap-3 rounded-lg px-3 py-2.5 -mx-1 transition-all hover:bg-surface-1 border border-transparent hover:border-zinc-800/50"
                  >
                    <div class="min-w-0">
                      <span class="text-[14px] text-zinc-300 group-hover:text-foreground transition-colors font-medium">{item.title}</span>
                      {item.description && (
                        <span class="block text-sm text-zinc-600 mt-0.5 line-clamp-1">{item.description}</span>
                      )}
                    </div>
                    <svg class="w-4 h-4 text-zinc-700 group-hover:text-primary shrink-0 mt-0.5 opacity-0 group-hover:opacity-100 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="mt-16 relative rounded-2xl border border-zinc-800/60 overflow-hidden p-6 sm:p-8" data-reveal>
        <div class="absolute inset-0 bg-gradient-to-br from-primary/[0.06] via-surface-1 to-transparent pointer-events-none"></div>
        <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="font-display text-lg font-semibold text-foreground">Spot a gap?</h2>
            <p class="mt-1 text-sm text-zinc-500">Docs live next to the product. PRs welcome. Stuck mid-install? Ask in Discord.</p>
          </div>
          <div class="flex flex-wrap gap-2 self-start sm:self-auto">
            <a
              href="https://discord.gg/mybxhmru3y"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 px-4 py-2.5 text-sm font-medium text-zinc-300 hover:bg-surface-2 hover:text-zinc-100 transition-colors active:scale-[0.98]"
            >
              Join Discord
            </a>
            <a
              href="https://github.com/catalystctl/catalyst-website"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary-600 transition-colors active:scale-[0.98] shadow-[0_0_0_1px_hsl(29_47%_50%/0.3),0_8px_28px_-8px_hsl(29_47%_56%/0.45)]"
            >
              Edit on GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
