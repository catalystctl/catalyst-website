---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import '@fontsource-variable/jetbrains-mono';
import githubStats from "../data/github-stats.json";
import { formatCount } from "../lib/github-stats.mjs";
import HeroPanel from "../components/HeroPanel.astro";
import shot1 from "../assets/screenshots/user/dashboard.png";
import shot2 from "../assets/screenshots/user/profile.png";
import shot3 from "../assets/screenshots/user/server-test.png";
import shot4 from "../assets/screenshots/user/servers.png";

const B = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "") + "/";
const GITHUB_URL = "https://github.com/catalystctl/catalyst";
const DISCORD_URL = "https://discord.gg/mybxhmru3y";
const INSTALL_CMD = "curl -fsSL https://raw.githubusercontent.com/catalystctl/catalyst/main/install.sh | bash";

const previewShots = [
  { img: shot1, url: "panel.catalystctl.com/dashboard", caption: "Fleet dashboard", sub: "Every server at a glance", alt: "Catalyst dashboard with server fleet overview" },
  { img: shot2, url: "panel.catalystctl.com/account", caption: "Account & security", sub: "2FA, API keys, sessions", alt: "Catalyst user profile and account settings" },
  { img: shot3, url: "panel.catalystctl.com/server/console", caption: "Live console", sub: "Bidirectional, <10ms round-trip", alt: "Catalyst live server console and test output" },
  { img: shot4, url: "panel.catalystctl.com/servers", caption: "Servers list", sub: "Search, filter, act in bulk", alt: "Catalyst servers list with status and resources" },
];

const steps = [
  {
    n: "01",
    title: "Install the panel.",
    body: "One script brings up the full stack: panel, database, reverse proxy. Auto-generated secrets, TLS-ready defaults.",
    code: "$ curl -fsSL … | bash",
  },
  {
    n: "02",
    title: "Add a node.",
    body: "Point it at any Linux box with containerd. The agent is a single lightweight Rust binary — no daemon maze.",
    code: "agent ▸ registered · rtt 4ms",
  },
  {
    n: "03",
    title: "Deploy from a template.",
    body: "Minecraft, CS2, ARK, Terraria — anything that runs in a Linux container. Console streams before you finish reading this.",
    code: "> Done (3.72s)! Server listening :25565",
  },
];

const bigStats = [
  { value: "<10ms", label: "WebSocket console round-trip", hint: "Native Rust layer. No Node hop in the middle.", live: true },
  { value: "<60s", label: "Bare server to running panel", hint: "One script. Docker Compose included." },
  { value: "60+", label: "REST API endpoints", hint: "Automate everything. RBAC-aware down to the route." },
  { value: "~50MB", label: "Panel footprint at rest", hint: "Rust core. One core and half a gig of RAM for small fleets." },
];

// Deterministic pseudo-random CPU baseline per node so the grid looks live but stable
const cpuFor = (name: string) => {
  const h = [...name].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 997, 7);
  return 12 + (h % 55);
};

const fleetNodes = [
  { name: "eu-west-1", kind: "bare-metal", ping: 4 },
  { name: "eu-west-2", kind: "bare-metal", ping: 5 },
  { name: "us-east-1", kind: "kvm", ping: 12 },
  { name: "us-east-2", kind: "kvm", ping: 14 },
  { name: "ap-south-1", kind: "kvm", ping: 38 },
  { name: "ap-northeast-1", kind: "bare-metal", ping: 52 },
  { name: "sa-east-1", kind: "kvm", ping: 44 },
  { name: "edge-hel-01", kind: "container", ping: 9 },
];

const features = [
  {
    title: "Create Server",
    description: "Deploy from a template in seconds with automatic environment provisioning.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>`,
  },
  {
    title: "Enterprise Security",
    description: "RBAC with 20+ permissions, API keys, audit logging, and TLS by default.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  },
  {
    title: "Register Node",
    description: "Add bare-metal or VM infrastructure with a lightweight Rust agent.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>`,
  },
  {
    title: "Plugin System",
    description: "Extend the API with custom routes, hooks, and scheduled background tasks.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>`,
  },
  {
    title: "View Alerts",
    description: "Customizable alerts and monitoring dashboards across every node in your fleet.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>`,
  },
  {
    title: "Scheduled Tasks",
    description: "Automate restarts, backups, and maintenance windows with built-in cron scheduling.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    title: "Audit Logging",
    description: "Every administrative action recorded with actor, IP, and timestamp.",
    icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>`,
  },
];

const comparison = [
  { feature: "Runtime", catalyst: "containerd (native)", pterodactyl: "Docker (layered)" },
  { feature: "Backend", catalyst: "Rust + TypeScript", pterodactyl: "PHP" },
  { feature: "WebSocket latency", catalyst: "<10ms", pterodactyl: "~100ms" },
  { feature: "API endpoints", catalyst: "60+ REST", pterodactyl: "~40" },
  { feature: "Plugin system", catalyst: "Native hooks", pterodactyl: "None" },
  { feature: "RBAC permissions", catalyst: "20+ granular", pterodactyl: "Basic" },
  { feature: "Install", catalyst: "Single script", pterodactyl: "Manual + Wings" },
];

const gh = githubStats;

const faqs = [
  {
    q: "Is Catalyst a Pterodactyl replacement?",
    a: "Yes. Catalyst covers the same core use cases (game server management, node orchestration, user panels, admin dashboards) with a faster Rust backend, containerd runtime, and a plugin system Pterodactyl lacks.",
  },
  {
    q: "How is Catalyst different from Pterodactyl?",
    a: "Catalyst uses Rust instead of PHP, containerd instead of Docker, and ships 60+ REST endpoints. You also get a native plugin system, sub-10ms WebSocket console latency, and RBAC with 20+ granular permissions.",
  },
  {
    q: "Can I migrate from Pterodactyl to Catalyst?",
    a: "Yes. Catalyst supports importing servers, eggs, and user data from Pterodactyl. The migration guide walks through each step. The containerd runtime works with most Pterodactyl Docker images.",
  },
  {
    q: "Is Catalyst free and open source?",
    a: "Yes. Catalyst is GPLv3. Backend, frontend, node agent, and docs are on GitHub. No paid tiers or feature gates.",
  },
  {
    q: "What games does Catalyst support?",
    a: "Any game that runs in a Linux container: Minecraft (Java and Bedrock), Counter-Strike 2, Rust, ARK, Terraria, Team Fortress 2, and hundreds more through custom egg definitions.",
  },
  {
    q: "What are the system requirements?",
    a: "Any Linux server with Docker and Docker Compose. The panel needs about one CPU core and 512MB RAM for small fleets. Nodes need containerd and the Catalyst agent.",
  },
];

const archLayers = [
  { name: "Your game server", detail: "Minecraft · CS2 · ARK · anything", tone: "dim" },
  { name: "Catalyst", detail: "Panel · console · scheduling · RBAC", tone: "hl" },
  { name: "containerd", detail: "Native runtime. No Docker daemon.", tone: "" },
  { name: "Linux", detail: "Any distro with kernel ≥ 5.x", tone: "dim" },
];
---

<Layout title="Home" description="Catalyst replaces Pterodactyl with a Rust backend, containerd runtime, and 60+ API endpoints. Deploy game servers in 60 seconds. Free, open source, GPLv3.">

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden" aria-label="Catalyst overview">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[36rem] hero-glow"></div>
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 h-[26rem] w-[46rem] rounded-full bg-primary/[0.07] blur-3xl"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 pt-20 pb-6 sm:pt-28 lg:pt-32 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-success/20 bg-success/[0.08] px-3 py-1 text-xs font-medium text-success mb-8" data-reveal>
        <span class="status-dot status-dot-success"></span>
        Open source · GPLv3 · no feature gates
      </div>

      <h1 class="font-display font-bold text-foreground tracking-tight leading-[1.04]" style="font-size: clamp(2.75rem, 7.5vw, 5rem);" data-reveal>
        Game servers<br />
        that feel <span class="text-primary">instant.</span>
      </h1>

      <p class="mt-6 mx-auto max-w-xl text-base sm:text-lg text-zinc-400 leading-relaxed text-balance" data-reveal>
        The modern open-source alternative to Pterodactyl. Rust core, native containerd runtime, sub-10ms console streaming — installed by a single command.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal>
        <a href="#install" class="cta-primary inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:bg-primary-600 active:scale-[0.98] min-h-11 shadow-[0_0_0_1px_hsl(29_47%_50%/0.3),0_8px_28px_-8px_hsl(29_47%_56%/0.45)]">
          Install Catalyst
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" /></svg>
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700/80 bg-surface-1/60 px-6 py-3 text-sm font-medium text-zinc-200 transition-all duration-200 hover:bg-surface-2 hover:border-zinc-600 active:scale-[0.98] min-h-11">
          GitHub
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>

      <!-- Inline install chip -->
      <div class="mt-6 inline-flex max-w-full items-center gap-3 rounded-lg border border-zinc-800/70 bg-surface-1/70 pl-4 pr-1.5 py-1.5 font-mono text-xs sm:text-[13px]" data-reveal>
        <span class="text-primary select-none shrink-0">$</span>
        <code class="text-zinc-300 truncate">{INSTALL_CMD}</code>
        <button class="copy-btn shrink-0" data-copy={INSTALL_CMD} aria-label="Copy install command">
          Copy
        </button>
      </div>

      <div class="mt-2 font-mono text-xs text-zinc-600 tracking-wide" data-reveal>
        rust <span class="text-zinc-700">→</span> containerd <span class="text-zinc-700">→</span> <span class="text-primary/80">&lt;10ms</span>
      </div>

      <!-- Social proof strip (live from GitHub) -->
      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-1 gap-y-1.5 font-mono text-[11px] text-zinc-500 tabular-nums" data-reveal>
        <a href={`${gh.repoUrl}/commits/main`} target="_blank" rel="noopener noreferrer" class="px-1.5 py-0.5 rounded transition-colors hover:text-zinc-200 hover:bg-surface-2">{formatCount(gh.commits) ?? "?"} commits</a>
        <span class="text-zinc-800">·</span>
        <a href={`${gh.repoUrl}/releases`} target="_blank" rel="noopener noreferrer" class="px-1.5 py-0.5 rounded transition-colors hover:text-zinc-200 hover:bg-surface-2">{formatCount(gh.releases) ?? "?"} releases</a>
        <span class="text-zinc-800">·</span>
        <a href={gh.ci?.url ?? `${gh.repoUrl}/actions`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded transition-colors hover:text-zinc-200 hover:bg-surface-2">
          <span class:list={["inline-block w-1.5 h-1.5 rounded-full", gh.ci?.state === "passing" ? "bg-success" : gh.ci?.state === "failing" ? "bg-danger" : "bg-zinc-600"]}></span>
          CI {gh.ci?.label ?? "unknown"}
        </a>
        <span class="text-zinc-800">·</span>
        <a href={`${gh.repoUrl}/graphs/contributors`} target="_blank" rel="noopener noreferrer" class="px-1.5 py-0.5 rounded transition-colors hover:text-zinc-200 hover:bg-surface-2">{formatCount(gh.contributors) ?? "?"} contributors</a>
      </div>
    </div>

    <!-- Live panel demo -->
    <div class="relative max-w-5xl mx-auto px-4 mt-10 sm:mt-14" data-reveal>
      <HeroPanel />
    </div>
  </section>

  <!-- ═══ ZERO TO RUNNING ═══ -->
  <section class="relative overflow-hidden max-w-6xl mx-auto px-4 py-24 sm:py-28" aria-label="Getting started">
    <div class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-primary/[0.05] blur-3xl" aria-hidden="true"></div>
    <div class="mb-12 max-w-xl" data-reveal>
      <h2 class="font-display text-sm font-semibold tracking-[0.18em] uppercase text-zinc-500">From zero to running</h2>
      <h3 class="mt-4 font-display text-3xl sm:text-4xl font-semibold text-foreground tracking-tight text-balance">
        Three steps. Sixty seconds.
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3" data-reveal-stagger>
      {steps.map((s) => (
        <div class="spotlight-card group rounded-xl border border-zinc-800/60 bg-surface-1/50 p-6 sm:p-7 transition-colors duration-200 hover:border-zinc-700">
          <div class="font-mono text-xs text-primary">{s.n}</div>
          <h3 class="mt-3 font-display text-lg font-semibold text-foreground">{s.title}</h3>
          <p class="mt-2 text-sm text-zinc-500 leading-relaxed">{s.body}</p>
          <div class="mt-5 font-mono text-xs text-zinc-600 truncate transition-colors duration-200 group-hover:text-zinc-400">{s.code}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ BUILT TO FEEL FAST (big-type restraint) ═══ -->
  <section class="relative overflow-hidden max-w-6xl mx-auto px-4 py-24 sm:py-28" aria-label="Performance">
    <div class="pointer-events-none absolute -top-24 -left-16 h-72 w-72 rounded-full bg-primary/[0.05] blur-3xl" aria-hidden="true"></div>
    <div class="mb-12 max-w-xl" data-reveal>
      <h2 class="font-display text-sm font-semibold tracking-[0.18em] uppercase text-zinc-500">Built to feel fast</h2>
      <h3 class="mt-4 font-display text-3xl sm:text-4xl font-semibold text-foreground tracking-tight text-balance">
        Numbers that hold up under load.
      </h3>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        No daemon tax, no Node hop, no wasted megabytes. The panel stays out of your servers' way.
      </p>
    </div>

    <!-- Single shared grid: the value column is sized once from the widest
         numeral, so every label starts at the same left edge. -->
    <div class="grid grid-cols-1 sm:grid-cols-[auto_minmax(0,1fr)] items-center gap-x-8 lg:gap-x-14">
      {bigStats.map((s, i) => (
        <>
          {i > 0 && <div class="col-span-full h-px bg-zinc-800/50" aria-hidden="true"></div>}
          <div class="stat-value pt-8 pb-2 sm:py-10 font-display font-bold tracking-tighter tabular-nums leading-none whitespace-nowrap text-foreground" style="font-size: clamp(3.25rem, 8vw, 6.5rem);" data-reveal>
            {s.value}
          </div>
          <div class="max-w-md lg:max-w-sm pb-8 pt-2 sm:py-10" data-reveal>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="text-base sm:text-lg font-medium text-zinc-200 leading-snug">{s.label}</span>
              {s.live && (
                <span class="live-ms inline-flex items-center gap-1.5 rounded-full border border-success/25 bg-success/[0.08] px-2.5 py-0.5 font-mono text-[11px] font-medium text-success tabular-nums" title="Simulated live latency">
                  <span class="status-dot status-dot-success"></span>
                  <span data-live-ms>6.4ms</span>
                </span>
              )}
            </div>
            <p class="mt-2 text-sm text-zinc-500 leading-relaxed">{s.hint}</p>
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- ═══ YOUR ENTIRE FLEET ═══ -->
  <section class="relative overflow-hidden max-w-6xl mx-auto px-4 py-24 sm:py-28" aria-label="Fleet management">
    <div class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-primary/[0.05] blur-3xl" aria-hidden="true"></div>
    <div class="mb-12 max-w-xl" data-reveal>
      <h2 class="font-display text-sm font-semibold tracking-[0.18em] uppercase text-zinc-500">Fleet overview</h2>
      <h3 class="mt-4 font-display text-3xl sm:text-4xl font-semibold text-foreground tracking-tight text-balance">
        Your entire fleet. One screen.
      </h3>
      <p class="mt-4 text-sm sm:text-base text-zinc-400 leading-relaxed">
        Every node, every server, every heartbeat — streamed live across regions with per-second health telemetry.
      </p>
    </div>

    <div class="rounded-xl border border-zinc-800/70 overflow-hidden" data-reveal>
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-zinc-800/60 bg-surface-1/70">
        <span class="font-mono text-[11px] text-zinc-500">nodes · fleet overview</span>
        <span class="inline-flex items-center gap-1.5 text-[11px] text-success font-medium">
          <span class="status-dot status-dot-success"></span> 8 online
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-zinc-800/40">
        {fleetNodes.map((n, i) => (
          <div class:list={["px-4 py-4 sm:py-5", i % 2 === 0 ? "bg-surface-1/90" : "bg-surface-0/40"]}>
            <div class="flex items-center gap-2">
              <span class="status-dot status-dot-success node-dot-live"></span>
              <span class="font-mono text-xs text-zinc-200 truncate">{n.name}</span>
              <span class="fleet-ping ml-auto font-mono text-[10px] text-zinc-500 tabular-nums shrink-0" data-ping={n.ping}>{n.ping}ms</span>
            </div>
            <div class="mt-2 flex items-center gap-2">
              <div class="fleet-cpu-bar flex-1"><div class="fleet-cpu-fill" style={`width:${cpuFor(n.name)}%; animation-duration:${2.4 + (i % 4) * 0.7}s`}></div></div>
              <span class="font-mono text-[9px] text-zinc-600 tabular-nums shrink-0">{cpuFor(n.name)}%</span>
            </div>
            <div class="mt-1.5 text-[9px] uppercase tracking-wider text-zinc-700">{n.kind}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CONTAINERS WITHOUT DOCKER ═══ -->
  <section class="relative overflow-hidden max-w-6xl mx-auto px-4 py-24 sm:py-28" aria-label="Architecture">
